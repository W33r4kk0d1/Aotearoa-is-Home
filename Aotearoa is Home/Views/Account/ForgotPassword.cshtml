@model Aotearoa_is_Home.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5" style="max-width: 600px;">
    <h2>Forgot Password?</h2>
    <p>Enter the email address associated with your account.</p>

    @if (TempData["PasswordResetError"] != null)
    {
        <div class="alert alert-warning">
            @TempData["PasswordResetError"]
        </div>
    }

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Email Address
            </label>
            <input asp-for="Email" class="form-control"
                   type="email" autocomplete="email" />
            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Send Reset Link
        </button>

        <a asp-action="Login" class="btn btn-outline-secondary ms-2">
            Back to Login
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}