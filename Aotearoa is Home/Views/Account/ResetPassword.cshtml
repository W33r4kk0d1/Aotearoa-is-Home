@model Aotearoa_is_Home.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5" style="max-width: 600px;">
    <h2>Reset Password</h2>
    <p>Choose a new password for your account.</p>

    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <input asp-for="Email" type="hidden" />
        <input asp-for="Code" type="hidden" />

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">
                New Password
            </label>
            <input asp-for="NewPassword" class="form-control" />
            <span asp-validation-for="NewPassword"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">
                Confirm New Password
            </label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Reset Password
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}