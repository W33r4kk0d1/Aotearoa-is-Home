@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container py-5 text-center">
    <h2>Check Your Email</h2>

    <p>
        If an account exists for that email address and is eligible
        for password recovery, a password reset link will be sent.
        Please check your inbox and spam folder.
    </p>

    <a asp-action="Login" class="btn btn-primary">
        Return to Login
    </a>
</div>
