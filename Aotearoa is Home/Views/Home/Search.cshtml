@model List<Aotearoa_is_Home.Models.SettlementPage>

@{
    ViewData["Title"] = "Search";
    ViewData["HideHeader"] = true;

    var searchString = ViewData["SearchString"]?.ToString();
}

<div class="public-search-page">

    <div class="public-search-page-header">
        <span>SEARCH AOTEAROA IS HOME</span>

        <h1>Settlement Information</h1>

        @if (!string.IsNullOrWhiteSpace(searchString))
        {
            <p>
                Results for <strong>"@searchString"</strong>
            </p>
        }
    </div>

    <div class="public-search-results">

        @if (Model.Any())
        {
            foreach (var page in Model)
            {
                <article class="public-search-result-card">

                    <div class="public-search-result-icon">
                        📖
                    </div>

                    <div class="public-search-result-content">
                        <h2>@(page.CategoryName)</h2>

                        @foreach (var block in page.ContentBlocks)
                        {
                            @if (string.Equals(
                                block.Type, "heading",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <h3>@block.Content</h3>
                            }
                            else if (string.Equals(
                                block.Type, "image",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                @if (block.ImageData != null &&
                                     block.ImageData.Length > 0)
                                {
                                    <img src="data:@block.ImageContentType;base64,@Convert.ToBase64String(block.ImageData)"
                                         alt="@block.Content"
                                         class="img-fluid rounded mb-3" />
                                }
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(block.Content))
                                {
                                    <p>@block.Content</p>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(block.Details))
                            {
                                <p>@block.Details</p>
                            }
                        }

                    </div>

                </article>
            }
        }
        else
        {
            <div class="public-no-results">
                <div class="public-no-results-icon">🔎</div>

                <h2>No results found</h2>

                <p>
                    We couldn't find matching settlement information.
                    Try another keyword, such as healthcare,
                    accommodation, education or employment.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="public-btn public-btn-primary">
                    Back to Home
                </a>
            </div>
        }

    </div>
</div>