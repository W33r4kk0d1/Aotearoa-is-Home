@model List<Aotearoa_is_Home.Models.SettlementPage>

@{
    ViewData["Title"] = "Home";
    ViewData["HideHeader"] = true;
}

<div class="public-home">

    <!-- Hero -->
    <section class="public-hero">
        <div class="public-hero-content">

            <div class="public-logo">
                <img src="~/images/Logo.png"
                     alt="Aotearoa is Home"
                     asp-append-version="true" />
            </div>

            <h1>Welcome to Aotearoa</h1>

            <p>
                Find the information you need to
                <a asp-controller="Home"
                   asp-action="SupportingInformation"
                   class="settle-link">
                    settle
                </a>
                connect and feel at home in Aotearoa New Zealand.
            </p>

            <form asp-controller="Home"
                  asp-action="Search"
                  method="get"
                  class="public-search-form">

                <div class="public-search-box">
                    <span class="public-search-icon">🔍</span>

                    <input type="text"
                           name="searchString"
                           placeholder="Search for information..."
                           autocomplete="off" />

                    <button type="submit">Search</button>
                </div>
            </form>

            <div class="public-hero-actions">
                <a asp-controller="Account"
                   asp-action="Register"
                   class="public-btn public-btn-primary">
                    Create an Account
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="public-btn public-btn-secondary">
                    Sign In
                </a>
            </div>

        </div>
    </section>

    <!-- Explore -->
    <section class="public-section">
        <div class="public-section-heading">
            <span>EXPLORE AOTEAROA</span>
            <h2>Information to help you settle in</h2>
            <p>
                Find useful information about everyday life, essential
                services and support available in New Zealand.
            </p>
        </div>

        <div class="public-category-grid">
            @foreach (var page in Model.Take(4))
            {
                var description = page.ContentBlocks
                    .Where(b => !string.IsNullOrWhiteSpace(b.Content)
                                && !string.Equals(
                                    b.Type, "heading",
                                    StringComparison.OrdinalIgnoreCase))
                    .Select(b => b.Content)
                    .FirstOrDefault();

                <div class="public-category-card">

                    <h3>@(page.CategoryName)</h3>

                    <p>
                        @(string.IsNullOrWhiteSpace(description)
                            ? $"Explore settlement information about {page.CategoryName}."
                            : description)
                    </p>

                    <a href="@Url.Action("Search", "Home",
                                new { searchString = page.CategoryName })">
                        Explore <span>→</span>
                    </a>

                </div>
            }

        </div>
    </section>

    <!-- About -->
    <section class="public-about">
        <div class="public-about-content">
            <span>ABOUT AOTEAROA IS HOME</span>

            <h2>Making your settlement journey easier</h2>

            <p>
                Moving to a new country can be exciting, but it can
                also be challenging. Aotearoa is Home brings useful
                information, services and support together in one
                place to help international students and their
                families navigate life in New Zealand.
            </p>
        </div>
    </section>

    <!-- Call to action -->
    <section class="public-cta">
        <div class="public-cta-content">
            <h2>Ready to get started?</h2>

            <p>
                Create an account to access personalised features
                designed for international students and families.
            </p>

            <div class="public-hero-actions">
                <a asp-controller="Account"
                   asp-action="Register"
                   class="public-btn public-btn-primary">
                    Create an Account
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="public-btn public-btn-secondary">
                    Sign In
                </a>
            </div>
        </div>
    </section>

</div>