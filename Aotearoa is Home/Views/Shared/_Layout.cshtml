<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aotearoa_is_Home</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aotearoa_is_Home.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>
<body>

@{
    var hideHeader = ViewData["HideHeader"] as bool? ?? false;
}

@if (ViewData["HideHeader"] as bool? != true)
{
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light navbar-color border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Mobile menu button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

<ul class="navbar-nav flex-grow-1">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        { 
                             <!-- STUDENT NAVIGATION -->
                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="Student"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Checklist
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Calendar
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Posts
                                    </a>
                                </li>
                            }


                            <!-- FAMILY MEMBER NAVIGATION-->

                            @if (User.IsInRole("Family Member"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="Family"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Checklist
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Calendar
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                        Posts
                                    </a>
                                </li>
                            }


                            <!-- ADMIN NAVIGATION -->

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="Admin"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="Admin"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Users
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="Admin"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Settlement Content
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="Admin"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Events
                                    </a>
                                </li>
                            }

                            <!-- Service PROVIDER NAVIGATION -->

                            @if (User.IsInRole("Service Provider"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="ServiceProvider"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="ServiceProvider"
                                       asp-controller="Event"
                                       asp-action="Index">
                                        My Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area="ServiceProvider"
                                       asp-controller="Event"
                                       asp-action="Index">
                                        Create Event
                                    </a>
                                </li>
                            }
                        }
                    </ul>


                    <!-- ACCOUNT NAVIGATION -->

                    <ul class="navbar-nav">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   id="userDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    @User.Identity.Name
                                </a>


                                <ul class="dropdown-menu dropdown-menu-end"
                                    aria-labelledby="userDropdown">

                                    <li>
                                        @if (User.IsInRole("Student"))
                                        {
                                            <a class="dropdown-item"
                                               asp-area="Student"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Profile
                                            </a>
                                        }
                                        else if (User.IsInRole("Family Member"))
                                        {
                                            <a class="dropdown-item"
                                               asp-area="Family"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Profile
                                            </a>
                                        }
                                        else if (User.IsInRole("Admin"))
                                        {
                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Profile
                                            </a>
                                        }
                                        else if (User.IsInRole("Service Provider"))
                                        {
                                            <a class="dropdown-item"
                                               asp-area="ServiceProvider"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Profile
                                            </a>
                                        }
                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <li>
                                        <button type="button"
                                                class="dropdown-item"
                                                onclick="confirmLogout()">
                                            Logout
                                        </button>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Not logged in -->

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Sign In
                                </a>
                            </li>
                        }
                    </ul>
                </div>


                <!-- ROLE-BASED LOGO LINK-->

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Student"))
                    {
                        <a class="navbar-brand d-flex align-items-center gap-2"
                           asp-area="Student"
                           asp-controller="Home"
                           asp-action="Index">

                            <img src="~/images/Logo.png"
                                 alt="Aotearoa is Home"
                                 height="60"
                                 class="d-inline-block align-top rounded"
                                 asp-append-version="true" />
                        </a>
                    }
                    else if (User.IsInRole("Family Member"))
                    {
                        <a class="navbar-brand d-flex align-items-center gap-2"
                           asp-area="Family"
                           asp-controller="Home"
                           asp-action="Index">

                            <img src="~/images/Logo.png"
                                 alt="Aotearoa is Home"
                                 height="60"
                                 class="d-inline-block align-top rounded"
                                 asp-append-version="true" />

                        </a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a class="navbar-brand d-flex align-items-center gap-2"
                           asp-area="Admin"
                           asp-controller="Home"
                           asp-action="Index">

                            <img src="~/images/Logo.png"
                                 alt="Aotearoa is Home"
                                 height="60"
                                 class="d-inline-block align-top rounded"
                                 asp-append-version="true" />

                        </a>
                    }
                    else if (User.IsInRole("Service Provider"))
                    {
                        <a class="navbar-brand d-flex align-items-center gap-2"
                           asp-area="ServiceProvider"
                           asp-controller="Home"
                           asp-action="Index">

                            <img src="~/images/Logo.png"
                                 alt="Aotearoa is Home"
                                 height="60"
                                 class="d-inline-block align-top rounded"
                                 asp-append-version="true" />

                        </a>
                    }
                }
                else
                {
                    <!-- Anonymous user -->

                    <a class="navbar-brand d-flex align-items-center gap-2"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Login">

                        <img src="~/images/Logo.png"
                             alt="Aotearoa is Home"
                             height="60"
                             class="d-inline-block align-top rounded"
                             asp-append-version="true" />
                    </a>
                }

            </div>
        </nav>
    </header>
}


<main role="main" class="pb-3">
    @RenderBody()
</main>

<footer class="border-top footer text-muted">
    <center>
        <div class="container">
            Aotearoa is Home - &copy; 2026
            <br />
            Team VAAS
        </div>
    </center>
</footer>


<!-- Hidden logout form -->
<form id="logoutForm"
      asp-area=""
      asp-controller="Account"
      asp-action="Logout"
      method="post"
      style="display:none;">

    @Html.AntiForgeryToken()

</form>

<!-- Logout Confirmation Modal -->
<div id="logoutModal" class="logout-modal">

    <div class="logout-dialog">

        <button type="button"
                class="logout-close"
                onclick="closeLogoutModal()"
                aria-label="Close">
            &times;
        </button>

        <div class="logout-icon">
            <span>👋</span>
        </div>

        <h2>Ready to leave?</h2>

        <p>
            Are you sure you want to log out of
            <strong>Aotearoa is Home</strong>?
        </p>

        <div class="logout-actions">

            <button type="button"
                    class="logout-cancel"
                    onclick="closeLogoutModal()">
                Stay Logged In
            </button>

            <button type="button"
                    class="logout-confirm"
                    onclick="performLogout()">
                Logout
            </button>

        </div>

    </div>

</div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

<script>
    function confirmLogout() {
        const modal = document.getElementById("logoutModal");

        if (modal) {
            modal.classList.add("show");
        }
    }

    function closeLogoutModal() {
        const modal = document.getElementById("logoutModal");

        if (modal) {
            modal.classList.remove("show");
        }
    }

    function performLogout() {
        document.getElementById("logoutForm").submit();
    }

    // Close when clicking outside the dialog
    document.addEventListener("click", function (event) {
        const modal = document.getElementById("logoutModal");

        if (event.target === modal) {
            closeLogoutModal();
        }
    });

    // Close with Escape key
    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeLogoutModal();
        }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
