@model List<Aotearoa_is_Home.Models.SettlementPage>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student";
}

<div class="student-home">

    <div class="student-home-title">
        <span>How can we help you?</span>
    </div>

    <div class="category-grid">

        @foreach (var settlementPage in Model)
        {
            <a href="/Student/Settlement/View/@settlementPage.Id"
               class="category-box"
               style="background-image: url('/Student/Settlement/BackgroundImage/@settlementPage.Id');">

                <span>@settlementPage.CategoryName</span>

            </a>
        }

    </div>

</div>