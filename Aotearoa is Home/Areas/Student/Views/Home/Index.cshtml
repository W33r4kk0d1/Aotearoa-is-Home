@{
    ViewData["Title"] = "Home";
}

@model List<Aotearoa_is_Home.Models.SettlementPage>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student";
}

<div class="container home-container">

    <div class="category-grid">

        @foreach (var settlementPage in Model)
        {
            <a href="/Student/Settlement/View/@settlementPage.Id"
               class="category-box">

                <span>@(settlementPage.CategoryName)</span>

            </a>
        }

    </div>

</div>