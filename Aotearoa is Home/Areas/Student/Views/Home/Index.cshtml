
@model Aotearoa_is_Home.Models.ViewModels.StudentHomeViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Student";

    // Remove completed categories before selecting the first three.
    var displayedSettlementPages = Model.SettlementPages
        .Where(page =>
            Model.ChecklistProgress.ContainsKey(page.Id) &&
            Model.ChecklistProgress[page.Id].Total > 0 &&
            Model.ChecklistProgress[page.Id].Completed <
                Model.ChecklistProgress[page.Id].Total)
        .Take(3)
        .ToList();

    // Recommend the first category that still needs attention.
    var recommendedPageId = displayedSettlementPages
    .Where(x =>
        Model.ChecklistProgress.ContainsKey(x.Id) &&
        Model.ChecklistProgress[x.Id].Total > 0 &&
        Model.ChecklistProgress[x.Id].Completed <
            Model.ChecklistProgress[x.Id].Total)
    .Select(x => x.Id)
    .FirstOrDefault();
}

<div class="student-home">

    <section class="student-home-hero">
        <div class="student-home-hero-content">
            <span class="student-eyebrow">
                WELCOME
            </span>

            <h1>Your Aotearoa journey starts here</h1>

            <p>
                Find useful information, events, and resources
                to help you settle into life in New Zealand.
            </p>
        </div>
    </section>

    <section class="student-home-section">

        <div class="student-section-title-row">
            <div>
                <span class="student-eyebrow">SETTLEMENT</span>
                <h2>Settlement Information</h2>
            </div>

            <a href="@Url.Action("Index", "Settlement", new { area = "Student" })"
               class="student-view-all">
                View all →
            </a>
        </div>

        @if (displayedSettlementPages.Any())
        {
            <div class="student-home-settlement-grid">

                @foreach (var settlementPage in displayedSettlementPages)
                {
                    var progress =
                        Model.ChecklistProgress[settlementPage.Id];

                    var isRecommended =
                            settlementPage.Id == recommendedPageId &&
                            progress != null &&
                            progress.Total > 0 &&
                            progress.Completed < progress.Total;

                    <a href="@Url.Action("View", "Settlement", new { area = "Student", id = settlementPage.Id })"
                       class="student-home-settlement-card">

                        @if (settlementPage.BackgroundImage != null &&
                             settlementPage.BackgroundImage.Length > 0)
                        {
                            <img src="data:@settlementPage.BackgroundImageContentType;base64,@Convert.ToBase64String(settlementPage.BackgroundImage)"
                                 alt="@settlementPage.CategoryName" />
                        }
                        else
                        {
                            <div class="student-home-settlement-placeholder"
                                 aria-hidden="true">
                                <i class="bi bi-house-heart"></i>
                            </div>
                        }

                        <div class="student-home-settlement-overlay"></div>

                        <div class="student-home-settlement-title">
                            @settlementPage.CategoryName
                        </div>

                        <div class="student-home-settlement-progress">

                            @if (isRecommended)
                            {
                                <span class="student-recommended-badge">
                                    Recommended for you
                                </span>
                            }

                            <div class="student-settlement-progress-info">
                                <span>@progress.Status</span>

                                <span>
                                    @progress.Completed / @progress.Total tasks
                                </span>
                            </div>

                            <div class="student-settlement-progress-track">
                                <div class="student-settlement-progress-fill"
                                     style="width: @progress.Percentage%">
                                </div>
                            </div>

                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="student-empty-state">
                <p>
                    You have completed all available settlement checklist
                    tasks. Great work!
                </p>

                <a href="@Url.Action("Index", "Settlement", new { area = "Student" })"
                   class="student-view-all">
                    Explore settlement information →
                </a>
            </div>
        }

    </section>

    <section class="student-home-section">

        <div class="student-section-title-row">
            <div>
                <span class="student-eyebrow">COMMUNITY</span>
                <h2>Upcoming Events</h2>
            </div>

            <a href="@Url.Action("Index", "Event", new { area = "Student" })"
               class="student-view-all">
                View all →
            </a>
        </div>

        @if (Model.Events.Any())
        {
            <div class="student-home-event-grid">

                @foreach (var eventItem in Model.Events)
                {
                    <a href="@Url.Action("Details", "Event", new { area = "Student", id = eventItem.Id })"
                       class="student-home-event-card">

                        @if (eventItem.ImageData != null)
                        {
                            <img src="data:@eventItem.ImageContentType;base64,@Convert.ToBase64String(eventItem.ImageData)"
                                 alt="@eventItem.Title" />
                        }

                        <div class="student-home-event-content">

                            @if (!string.IsNullOrWhiteSpace(eventItem.Category))
                            {
                                <span class="student-event-category">
                                    @eventItem.Category
                                </span>
                            }

                            <h3>@eventItem.Title</h3>

                            <p>@eventItem.Location</p>

                            <small>
                                @eventItem.StartDate.ToString("dd/MM/yyyy h:mm tt")
                            </small>

                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="student-empty-state">
                No upcoming events are currently available.
            </div>
        }

    </section>

</div>
