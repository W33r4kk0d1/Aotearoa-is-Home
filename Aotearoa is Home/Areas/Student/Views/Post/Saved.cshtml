
@model List<Aotearoa_is_Home.Models.CommunityPost>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Saved Community Posts";
}

<link rel="stylesheet"
      href="~/css/student-posts.css"
      asp-append-version="true" />

<div class="student-posts-page">

    <section class="student-posts-intro">
        <span class="student-eyebrow">
            COMMUNITY & CONNECTIONS
        </span>

        <h1>Saved Posts</h1>
        <p>
            Your favourite community posts,
            all in one place.
        </p>

        <div class="student-posts-actions">
            <a href="/Student/Post/Index"
               class="student-posts-secondary">
                ← All Posts
            </a>
        </div>
    </section>

    <section class="student-posts-content">

        @if (!Model.Any())
        {
            <div class="student-posts-empty">
                <h3>No saved posts yet</h3>
                <p>
                    Explore community posts and select
                    the star to save posts here.
                </p>

                <a asp-area="Student"
                   asp-controller="Post"
                   asp-action="Index"
                   class="student-posts-primary">
                    Browse Posts
                </a>
            </div>
        }
        else
        {
            <div class="my-posts-list">
                @foreach (var post in Model)
                {
                    <article class="my-post-card community-post-card">

                        <div class="my-post-card-header">
                            <span class="my-post-category">
                                @post.Category
                            </span>

                            <form asp-area="Student"
                                  asp-controller="Post"
                                  asp-action="ToggleFavourite"
                                  method="post"
                                  class="saved-post-form">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@post.Id" />

                                <button type="submit"
                                        class="post-favourite-btn saved"
                                        title="Remove saved post">
                                    ★
                                </button>
                            </form>
                        </div>

                        <h3>@post.Title</h3>

                        <p class="my-post-description">@post.Description</p>

                        @if (post.ImageData != null &&
                             post.ImageContentType != null)
                        {
                            var imageSource =
                                $"data:{post.ImageContentType};base64," +
                                Convert.ToBase64String(post.ImageData);

                            <img src="@imageSource"
                                 alt="Image attached to @post.Title"
                                 class="my-post-image" />
                        }

                        <div class="my-post-footer">
                            Posted on

                            @(post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>



<script>
document.querySelectorAll(".saved-post-form")
    .forEach(form => {
        form.addEventListener("submit", async function (event) {
            event.preventDefault();

            const button = form.querySelector("button");

            if (button.disabled) return;

            button.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form)
                });

                if (!response.ok) {
                    throw new Error("Request failed");
                }

                const result = await response.json();

                if (result.success && !result.isSaved) {
                    const card = form.closest(".community-post-card");
                    if (card) card.remove();

                    const remainingCards = document.querySelectorAll(
                        ".community-post-card"
                    );

                    if (remainingCards.length === 0) {
                        window.location.reload();
                    }
                } else {
                    throw new Error("Unexpected server response");
                }
            } catch (error) {
                alert("Unable to remove saved post. Please try again.");
                button.disabled = false;
            }
        });
    });
</script>
