@model IEnumerable<Aotearoa_is_Home.Models.Event>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Events";

    var currentArea =
        ViewContext.RouteData.Values["area"]?.ToString();

    var events = Model.ToList();

    var categories = events
        .Where(e => !string.IsNullOrWhiteSpace(e.Category))
        .Select(e => e.Category!)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    var regions = events
        .Where(e => !string.IsNullOrWhiteSpace(e.Region))
        .Select(e => e.Region!)
        .Distinct()
        .OrderBy(r => r)
        .ToList();
}

<div class="student-events-page">

    <section class="student-events-intro">

        <span class="student-eyebrow">
            COMMUNITY & EVENTS
        </span>

        <h1>
            Events happening around you
        </h1>

        <p>
            Discover events, activities, and opportunities
            happening in your community.
        </p>

    </section>

    <div class="student-events-filters">

        <!-- SEARCH -->

        <div class="student-events-search">

            <div class="student-search-wrapper">

                <span class="student-search-icon">
                    🔍
                </span>

                <input type="text"
                       id="eventSearch"
                       class="student-search-input"
                       placeholder="Search events..."
                       autocomplete="off" />

            </div>

        </div>


        <!-- FILTERS -->

        @if (categories.Any() || regions.Any())
        {
            <div class="student-event-filter-row">

                <!-- CATEGORY -->

                <div class="student-event-filter">

                    <label for="categoryFilter">
                        Category
                    </label>

                    <select id="categoryFilter"
                            class="student-event-filter-select">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in categories)
                        {
                            <option value="@category">
                                @category
                            </option>
                        }

                    </select>

                </div>


                <!-- LOCATION / REGION -->

                <div class="student-event-filter">

                    <label for="regionFilter">
                        Location
                    </label>

                    <select id="regionFilter"
                            class="student-event-filter-select">

                        <option value="">
                            All Locations
                        </option>

                        @foreach (var region in regions)
                        {
                            <option value="@region">
                                @region
                            </option>
                        }

                    </select>

                </div>


                <!-- CLEAR FILTERS -->

                <div class="student-event-filter-clear">

                    <button type="button"
                            id="clearEventFilters"
                            class="student-event-clear-button">

                        Clear Filters

                    </button>

                </div>

            </div>
        }

    </div>


    @if (!events.Any())
    {
        <div class="student-empty-state">

            <h2>
                No events are currently available
            </h2>

            <p>
                Check back later for upcoming events and activities.
            </p>

        </div>
    }
    else
    {
        <div class="student-event-grid"
             id="eventGrid">

            @foreach (var eventItem in events)
            {
                <a href="@Url.Action(
                            "Details",
                            "Event",
                            new
                            {
                                area = currentArea,
                                id = eventItem.Id
                            })"
                   class="student-event-card"
                   data-search="@eventItem.Title @eventItem.Category @eventItem.Location @eventItem.Region @eventItem.Description"
                   data-category="@eventItem.Category"
                   data-region="@eventItem.Region">

                    <!-- IMAGE -->

                    @if (eventItem.ImageData != null &&
                         eventItem.ImageData.Length > 0)
                    {
                        <div class="student-event-card-image-wrapper">

                            <img src="data:@eventItem.ImageContentType;base64,@Convert.ToBase64String(eventItem.ImageData)"
                                 alt="@eventItem.Title"
                                 class="student-event-card-image" />

                        </div>
                    }
                    else
                    {
                        <div class="student-event-card-placeholder">

                            <span>
                                EVENT
                            </span>

                        </div>
                    }


                    <!-- CONTENT -->

                    <div class="student-event-card-content">

                        @if (!string.IsNullOrWhiteSpace(eventItem.Category))
                        {
                            <span class="student-event-category">
                                @eventItem.Category
                            </span>
                        }

                        <h2>
                            @eventItem.Title
                        </h2>

                        <p class="student-event-description">
                            @eventItem.Description
                        </p>


                        <div class="student-event-info">

                            <!-- DATE -->

                            <div>

                                <strong>
                                    📅
                                </strong>

                                @eventItem.StartDate.ToString(
                                    "dd MMM yyyy, h:mm tt")

                            </div>


                            <!-- LOCATION -->

                            <div>

                                <strong>
                                    📍
                                </strong>

                                @eventItem.Location

                            </div>

                        </div>


                        <!-- REGION -->

                        @if (!string.IsNullOrWhiteSpace(eventItem.Region))
                        {
                            <div class="student-event-region">

                                📍 @eventItem.Region

                            </div>
                        }


                        <div class="student-event-view">

                            View event

                            <span>
                                →
                            </span>

                        </div>

                    </div>

                </a>
            }

        </div>


        <!--  NO SEARCH / FILTER RESULTS -->

        <div id="eventNoResults"
             class="student-empty-state"
             style="display: none;">

            <h2>
                No matching events found
            </h2>

            <p>
                Try changing your search or filters.
            </p>

        </div>
    }

</div>


<!-- FILTER SCRIPT -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("eventSearch");

        const categoryFilter =
            document.getElementById("categoryFilter");

        const regionFilter =
            document.getElementById("regionFilter");

        const clearButton =
            document.getElementById("clearEventFilters");

        const eventCards =
            document.querySelectorAll(".student-event-card");

        const noResults =
            document.getElementById("eventNoResults");


        function filterEvents() {

            const searchText =
                searchInput
                    ? searchInput.value.trim().toLowerCase()
                    : "";

            const selectedCategory =
                categoryFilter
                    ? categoryFilter.value.trim().toLowerCase()
                    : "";

            const selectedRegion =
                regionFilter
                    ? regionFilter.value.trim().toLowerCase()
                    : "";

            let visibleCount = 0;


            eventCards.forEach(function (card) {

                const searchContent =
                    (card.dataset.search || "").toLowerCase();

                const cardCategory =
                    (card.dataset.category || "").toLowerCase();

                const cardRegion =
                    (card.dataset.region || "").toLowerCase();


                const matchesSearch =
                    searchText === "" ||
                    searchContent.includes(searchText);


                const matchesCategory =
                    selectedCategory === "" ||
                    cardCategory === selectedCategory;


                const matchesRegion =
                    selectedRegion === "" ||
                    cardRegion === selectedRegion;


                if (
                    matchesSearch &&
                    matchesCategory &&
                    matchesRegion
                ) {

                    card.style.display = "";

                    visibleCount++;

                }
                else {

                    card.style.display = "none";

                }

            });


            if (noResults) {

                if (visibleCount === 0) {

                    noResults.style.display = "block";

                }
                else {

                    noResults.style.display = "none";

                }

            }

        }


        /* SEARCH */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterEvents
            );

        }


        /* CATEGORY */

        if (categoryFilter) {

            categoryFilter.addEventListener(
                "change",
                filterEvents
            );

        }


        /* REGION */

        if (regionFilter) {

            regionFilter.addEventListener(
                "change",
                filterEvents
            );

        }


        /* CLEAR */

        if (clearButton) {

            clearButton.addEventListener(
                "click",
                function () {

                    if (searchInput) {
                        searchInput.value = "";
                    }

                    if (categoryFilter) {
                        categoryFilter.value = "";
                    }

                    if (regionFilter) {
                        regionFilter.value = "";
                    }

                    filterEvents();

                }
            );

        }

    });

</script>