@model List<Aotearoa_is_Home.Models.StudentChecklist>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Checklists";

    var totalCount = Model.Sum(x => x.Items.Count);
    var completedCount = Model.Sum(x => x.Items.Count(i => i.IsCompleted));

    var overallProgress = totalCount == 0
        ? 0
        : (completedCount * 100) / totalCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Checklist.css" asp-append-version="true" />
}

<div class="settlement-checklist">
    <div class="checklist-page-header">
        <div>
            <h1>My Checklists</h1>
            <p>Track your progress as you settle into New Zealand.</p>
        </div>
    </div>

    <div class="overall-section">
        <div class="overall-header">
            <strong>Overall Progress</strong>
            <span>@completedCount of @totalCount tasks completed</span>
        </div>

        <div class="overall-track">
            <div class="overall-fill" style="width: @(overallProgress)%"></div>
        </div>

        <div class="overall-percentage">@overallProgress%</div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-checklist">
            <h2>No checklists available</h2>
            <p>Your settlement checklists will appear here when they are available.</p>
        </div>
    }
    else
    {
        <div class="checklist-list">
            @foreach (var checklist in Model)
            {
                var checklistTotal = checklist.Items.Count;
                var checklistCompleted = checklist.Items.Count(x => x.IsCompleted);

                var checklistProgress = checklistTotal == 0
                    ? 0
                    : (checklistCompleted * 100) / checklistTotal;

                var status = checklist.IsArchived
                    ? "Archived"
                    : checklistProgress == 100 && checklistTotal > 0
                        ? "Completed"
                        : checklistProgress > 0
                            ? "In Progress"
                            : "Not Started";

                <div class="category-card">
                    <div class="category-header">
                        <div>
                            <h2>@checklist.Name</h2>
                            <p>Created @checklist.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                        </div>

                        <div class="checklist-status-area">
                            <span class="category-status status-@status.Replace(" ", "-").ToLowerInvariant()">
                                @status
                            </span>
                        </div>
                    </div>

                    <div class="category-tasks">
                        <div class="progress-summary">
                            <span>@checklistCompleted of @checklistTotal tasks completed</span>
                            <span>@checklistProgress%</span>
                        </div>

                        <div class="task-progress-track">
                            <div class="task-progress-fill" style="width: @(checklistProgress)%"></div>
                        </div>
                    </div>

                    <form action="@Url.Action("Update", "Checklist", new { area = "Student" })"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="checklistId" value="@checklist.Id" />

                        @{
                            var categories = checklist.Items
                                .Where(x => x.ChecklistTask?.SettlementPage != null)
                                .GroupBy(x => x.ChecklistTask!.SettlementPage!.Id)
                                .ToList();
                        }

                        @if (!categories.Any())
                        {
                            <div class="empty-checklist">
                                <p>No checklist tasks are currently available.</p>
                            </div>
                        }
                        else
                        {
                            foreach (var category in categories)
                            {
                                var categoryItems = category.ToList();
                                var settlementPage = categoryItems.First().ChecklistTask!.SettlementPage!;

                                var categoryTotal = categoryItems.Count;
                                var categoryCompleted = categoryItems.Count(x => x.IsCompleted);

                                var categoryProgress = categoryTotal == 0
                                    ? 0
                                    : (categoryCompleted * 100) / categoryTotal;

                                <section class="category-section">
                                    <div class="category-section-header">
                                        <h3>@settlementPage.CategoryName</h3>
                                        <span>@categoryCompleted of @categoryTotal completed</span>
                                    </div>

                                    <div class="task-progress-track">
                                        <div class="task-progress-fill" style="width: @(categoryProgress)%"></div>
                                    </div>

                                    <div class="task-list">
                                        @foreach (var item in categoryItems.OrderBy(x => x.ChecklistTask!.DisplayOrder))
                                        {
                                            <div class="task-row">
                                                <div class="task-checkbox">
                                                    <input type="checkbox"
                                                           name="completedItems"
                                                           value="@item.Id"
                                                           id="item-@item.Id"
                                                           checked="@item.IsCompleted"
                                                           disabled="@checklist.IsArchived" />
                                                </div>

                                                <div class="task-information">
                                                    <label class="task-title" for="item-@item.Id">
                                                        @item.ChecklistTask!.Title
                                                    </label>

                                                    @if (!string.IsNullOrWhiteSpace(item.ChecklistTask.Description))
                                                    {
                                                        <p class="task-description">
                                                            @item.ChecklistTask.Description
                                                        </p>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        }

                        <div class="checklist-actions">
                            

                            @if (!checklist.IsArchived)
                            {
                                <button class="btn btn-primary save-progress-button" type="submit">
                                    Save Progress
                                </button>
                            }
                        </div>
                    </form>
                </div>
            }
        </div>
    }
</div>
