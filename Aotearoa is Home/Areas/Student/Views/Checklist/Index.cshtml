@model List<Aotearoa_is_Home.Models.StudentChecklist>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Checklists";
}

<div class="settlement-checklist">

    <div class="checklist-page-header">

        <div>
            <h1 class="checklist-title">
                My Checklists
            </h1>

            <p>
                Create and manage your personalised New Zealand settlement checklists.
            </p>
        </div>

        <div>
            <a href="@Url.Action("Create", "Checklist", new { area = "Student"})"
                class="save-progress-button">
                    + Create New Checklist
            </a>
        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-checklist">

            <h2>No checklists yet</h2>

            <p>
                Create your first checklist and choose the topics that are relevant to you.
            </p>

            <a asp-area="Student"
               asp-controller="Checklist"
               asp-action="Create"
               class="save-progress-button">
                Create My First Checklist
            </a>

        </div>
    }
    else
    {
        <div class="checklist-list">

            @foreach (var checklist in Model)
            {
                var totalCount = checklist.Items.Count;

                var completedCount =
                    checklist.Items.Count(x => x.IsCompleted);

                var progress = totalCount == 0
                    ? 0
                    : (completedCount * 100) / totalCount;

                var status = checklist.IsArchived
                    ? "Archived"
                    : "Active";

                var statusClass = checklist.IsArchived
                    ? "status-not-started"
                    : progress == 100 && totalCount > 0
                        ? "status-done"
                        : progress > 0
                            ? "status-progress"
                            : "status-not-started";


                <div class="category-card">

                    <div class="category-header">

                        <div>
                            <h2>
                                @checklist.Name
                            </h2>

                            <div class="task-description">
                                Created
                                @checklist.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                        </div>

                        <span class="category-status @statusClass">
                            @status
                        </span>

                    </div>


                    <div class="category-tasks">

                        <div style="padding: 10px 0;">

                            <div style="
                                display: flex;
                                justify-content: space-between;
                                align-items: center;
                                margin-bottom: 8px;
                                font-weight: 600;
                            ">
                                <span>
                                    @completedCount of @totalCount tasks completed
                                </span>

                                <span>
                                    @progress%
                                </span>
                            </div>

                            <div class="task-progress-track">

                                <div class="task-progress-fill"
                                    style="width: @progress%">
                                </div>

                            </div>

                        </div>

                    </div>


                   <div class="category-arrow">

                        <div class="checklist-actions">

                            <a href="@Url.Action("ViewChecklist", "Checklist", new { area = "Student", id = checklist.Id })"
                            class="btn btn-outline-primary btn-sm">
                                Open →
                            </a>

                            @if (!checklist.IsArchived)
                            {
                                <a href="@Url.Action("Customize", "Checklist", new { area = "Student", id = checklist.Id })"
                                class="btn btn-outline-secondary btn-sm">
                                    Customize
                                </a>
                            }

                        </div>

                    </div>

                </div>
            }
        </div>
    }

</div>

<style>
    /* Small visual polish for My Checklists */

    .checklist-page-header {
        margin-bottom: 24px;
    }

    .checklist-page-header > div:last-child {
        margin-top: 4px;
    }

    .checklist-list {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .checklist-list .category-card {
        padding: 28px;
    }

    .checklist-list .category-header {
        margin-bottom: 18px;
    }

    .checklist-list .category-header h2 {
        margin-bottom: 4px;
    }

    .checklist-list .category-status {
        margin-top: 2px;
    }

    .checklist-list .category-tasks {
        margin-top: 4px;
        padding-top: 0;
    }

    .checklist-list .category-arrow {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px;
    }

    .checklist-list .task-progress-track {
        height: 7px;
        border-radius: 10px;
    }

    .checklist-list .task-progress-fill {
        height: 100%;
        border-radius: 10px;
    }

    .checklist-list .btn {
        min-width: 82px;
        text-align: center;
    }

    .checklist-list .btn + .btn {
        margin-left: 2px;
    }

    .checklist-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    @@media (max-width: 700px) {

        .checklist-list .category-card {
            padding: 20px;
        }

        .checklist-list .category-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .checklist-list .category-arrow {
            justify-content: flex-start;
        }
    }
</style>