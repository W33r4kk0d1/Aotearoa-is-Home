
@model List<Aotearoa_is_Home.Models.StudentChecklist>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Checklists";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>My Checklists</h1>
        <p class="text-muted">
            Track your progress towards settling into New Zealand.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary mb-4">
        <i class="bi bi-plus-lg"></i> Create Checklist
    </a>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h4>No checklists available</h4>
            <p>You do not have any checklists yet. Please check back later.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var checklist in Model)
            {
                var totalCount = checklist.Items?.Count ?? 0;

                var completedCount = checklist.Items?
                    .Count(item => item.IsCompleted) ?? 0;

                var progress = totalCount == 0
                    ? 0
                    : (completedCount * 100) / totalCount;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @checklist.Name
                            </h5>

                            <p class="text-muted">
                                @completedCount of @totalCount tasks completed
                            </p>

                            <div class="progress mb-3"
                                 role="progressbar"
                                 aria-label="Checklist progress"
                                 aria-valuenow="@progress"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                <div class="progress-bar"
                                     style="width: @(progress)%">
                                    @progress%
                                </div>
                            </div>

                            <p>
                                @(progress == 100
                                    ? "All tasks completed!"
                                    : "Continue working through your settlement tasks.")
                            </p>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a asp-action="ViewChecklist"
                                asp-route-id="@checklist.Id"
                                class="btn btn-primary">
                                    View
                                </a>

                                <a asp-action="Customize"
                                asp-route-id="@checklist.Id"
                                class="btn btn-outline-primary">
                                    Customize
                                </a>

                                <a asp-action="Delete"
                                asp-route-id="@checklist.Id"
                                class="btn btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
