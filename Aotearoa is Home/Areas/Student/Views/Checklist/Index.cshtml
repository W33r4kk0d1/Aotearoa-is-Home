@model List<Aotearoa_is_Home.Models.ChecklistItem>
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Settlement Checklist";

    var categories = Model
        .Where(x => x.ChecklistTask?.SettlementPage != null)
        .GroupBy(x => x.ChecklistTask!.SettlementPage!.Id)
        .ToList();

    var totalCount = Model.Count;
    var completedCount = Model.Count(x => x.IsCompleted);

    var overallProgress = totalCount == 0
        ? 0
        : (completedCount * 100) / totalCount;
}

<div class="settlement-checklist">

    <h1 class="checklist-title">
        Settlement Checklist
    </h1>

    <div class="overall-section">

        <div class="overall-label">
            <span>Overall Progress</span>
            <span>@overallProgress%</span>
        </div>

        <div class="overall-track">

            <div class="overall-fill"
                 style="width: @overallProgress%">
            </div>

        </div>

    </div>

    <form action="/Student/Checklist/Update" method="post">

        @Html.AntiForgeryToken()

        @if (!categories.Any())
        {
            <div class="empty-checklist">
                No checklist tasks are currently available.
            </div>
        }
        else
        {
            foreach (var category in categories)
            {
                var categoryItems = category.ToList();

                var settlementPage =
                    categoryItems.First().ChecklistTask!.SettlementPage!;

                var categoryTotal =
                    categoryItems.Count;

                var categoryCompleted =
                    categoryItems.Count(x => x.IsCompleted);

                var categoryProgress =
                    categoryTotal == 0
                        ? 0
                        : (categoryCompleted * 100) / categoryTotal;

                var status = "Not started";
                var statusClass = "status-not-started";

                if (categoryCompleted == categoryTotal &&
                    categoryTotal > 0)
                {
                    status = "Done";
                    statusClass = "status-done";
                }
                else if (categoryCompleted > 0)
                {
                    status = "In progress";
                    statusClass = "status-progress";
                }

                <div class="category-card">

                    <div class="category-header">

                        <h2>
                            @settlementPage.CategoryName
                        </h2>

                        <span class="category-status @statusClass">
                            @status
                        </span>

                    </div>

                    <div class="category-tasks">

                        @foreach (var item in categoryItems
                            .OrderBy(x => x.ChecklistTask!.DisplayOrder))
                        {
                            <div class="task-row">

                                <div class="task-checkbox">

                                    @if (item.IsCompleted)
                                    {
                                        <input type="checkbox"
                                               name="completedItems"
                                               value="@item.Id"
                                               id="item-@item.Id"
                                               checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox"
                                               name="completedItems"
                                               value="@item.Id"
                                               id="item-@item.Id" />
                                    }

                                </div>

                                <div class="task-information">

                                    <label for="item-@item.Id"
                                           class="task-title">
                                        @item.ChecklistTask!.Title
                                    </label>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.ChecklistTask.Description))
                                    {
                                        <div class="task-description">
                                            @item.ChecklistTask.Description
                                        </div>
                                    }

                                    <div class="task-progress-track">

                                        <div class="task-progress-fill"
                                             style="width: @(item.IsCompleted ? 100 : 0)%">
                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <div class="category-arrow">
                        →
                    </div>

                </div>
            }
        }

        @if (Model.Any())
        {
            <div class="save-area">

                <button type="submit"
                        class="save-progress-button">
                    Save Progress
                </button>

            </div>
        }

    </form>

</div>
