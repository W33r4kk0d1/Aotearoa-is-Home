
@model List<Aotearoa_is_Home.Models.StudentChecklist>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Checklists";
}

<div class="container checklist-page">

    <div class="checklist-page-header">
        <div class="checklist-heading-content">
            <span class="checklist-eyebrow">
                YOUR SETTLEMENT JOURNEY
            </span>
            <h1 class="checklist-heading">My Checklists</h1>
            <p class="checklist-subtitle">
                Every small step brings you closer to feeling at home in New Zealand.
            </p>
        </div>

        <a href="/Student/Checklist/Create"
           class="btn btn-create-checklist">
            <i class="bi bi-plus-circle me-2"></i>
            Create Checklist
        </a>
    </div>

        @{
            var totalChecklists = Model?.Count ?? 0;
            var totalTasks = Model?.Sum(c => c.Items?.Count ?? 0) ?? 0;
            var completedTasks = Model?.Sum(c =>
                c.Items?.Count(i => i.IsCompleted) ?? 0) ?? 0;
            var overallProgress = totalTasks == 0
                ? 0
                : (int)Math.Round(completedTasks * 100.0 / totalTasks);
        }
    
        <div class="checklist-summary">
            <div class="summary-item">
                <div class="summary-icon summary-icon-green">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <span class="summary-label">My checklists</span>
                    <h3>@totalChecklists</h3>
                </div>
            </div>

            <div class="summary-item">
                <div class="summary-icon summary-icon-blue">
                    <i class="bi bi-list-check"></i>
                </div>
                <div>
                    <span class="summary-label">Tasks completed</span>
                    <h3>@completedTasks <small>of @totalTasks</small></h3>
                </div>
            </div>

            <div class="summary-item">
                <div class="summary-icon summary-icon-purple">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <span class="summary-label">Overall progress</span>
                    <h3>@overallProgress%</h3>
                </div>
            </div>
        </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h4>No checklists available</h4>
            <p>You do not have any checklists yet. Please check back later.</p>
        </div>
    }
    else
    {
        <div class="row g-4 checklist-grid">
            @foreach (var checklist in Model)
            {
                var totalCount = checklist.Items?.Count ?? 0;

                var completedCount = checklist.Items?
                    .Count(item => item.IsCompleted) ?? 0;

                var progress = totalCount == 0
                    ? 0
                    : (completedCount * 100) / totalCount;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm checklist-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @checklist.Name
                            </h5>

                            <p class="text-muted">
                                @completedCount of @totalCount tasks completed
                            </p>

                            <div class="progress mb-3 checklist-progress"
                                 role="progressbar"
                                 aria-label="Checklist progress"
                                 aria-valuenow="@progress"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                <div class="progress-bar"
                                     style="width: @(progress)%">
                                    @progress%
                                </div>
                            </div>

                            <p>
                                @(progress == 100
                                    ? "All tasks completed!"
                                    : "Continue working through your settlement tasks.")
                            </p>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a href="/Student/Checklist/ViewChecklist?id=@checklist.Id"
                                class="btn btn-primary">
                                    View
                                </a>

                                <a href="/Student/Checklist/Customize?id=@checklist.Id"
                                class="btn btn-outline-primary">
                                    Customize
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@checklist.Id">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade"
                        id="deleteModal-@checklist.Id"
                        tabindex="-1"
                        aria-labelledby="deleteModalLabel-@checklist.Id"
                        aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title"
                                        id="deleteModalLabel-@checklist.Id">
                                            Confirm deletion
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                 <div class="modal-body">
                                                Are you sure you want to delete
                                    <strong>@checklist.Name</strong>?

                                    <p class="text-danger mb-0 mt-2">
                                                    This will permanently delete this checklist and its saved progress.
                                    </p>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    Cancel
                                    </button>

                                    <form action="/Student/Checklist/DeleteConfirmed"
                                                    method="post">
                                                    @Html.AntiForgeryToken()

                                        <input type="hidden"
                                                        name="id"
                                                        value="@checklist.Id" />

                                        <button type="submit"
                                                            class="btn btn-danger">
                                                        Yes, Delete
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                   </div>
                </div>
            }
        </div>
    }
</div>
</div>
