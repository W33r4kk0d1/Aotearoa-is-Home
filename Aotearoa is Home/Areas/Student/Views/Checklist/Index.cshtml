@model List<Aotearoa_is_Home.Models.ChecklistItem>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Events";
}

@{
    ViewData["Title"] = "Settlement Checklist";

    var completedCount = Model.Count(x => x.IsCompleted);
    var totalCount = Model.Count;

    var progress = totalCount == 0
        ? 0
        : (completedCount * 100) / totalCount;
}

<div class="container my-5">

    <div class="mb-4">
        <h1>Settlement Checklist</h1>

        <p class="text-muted">
            Track your progress as you settle into life in New Zealand.
        </p>
    </div>


    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between mb-2">

                <strong>Progress</strong>

                <span>
                    @completedCount / @totalCount completed
                </span>

            </div>

            <div class="progress" style="height: 20px;">

                <div class="progress-bar"
                     role="progressbar"
                     style="width: @progress%;">

                    @progress%

                </div>

            </div>

        </div>
    </div>


    <form asp-area="Student"
          asp-controller="Checklist"
          asp-action="Update"
          method="post">

        @Html.AntiForgeryToken()

        <div class="card shadow-sm">

            <div class="card-body">

                @if (!Model.Any())
                {
                    <p class="text-muted">
                        No checklist items have been created yet.
                    </p>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <div class="form-check border-bottom py-3">

                            <input class="form-check-input"
                                   type="checkbox"
                                   name="completedItems"
                                   value="@item.Id"
                                   id="item-@item.Id"
                            @(item.IsCompleted ? "checked" : "") />

                            <label class="form-check-label"
                                   for="item-@item.Id">

                                <strong>
                                    @item.Title
                                </strong>

                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="text-muted small mt-1">
                                        @item.Description
                                    </div>
                                }

                            </label>

                        </div>
                    }
                }

            </div>

            @if (Model.Any())
            {
                <div class="card-footer text-end">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Progress
                    </button>

                </div>
            }

        </div>

    </form>

</div>