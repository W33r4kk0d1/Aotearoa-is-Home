@model Aotearoa_is_Home.Models.ApplicationUser

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Profile";
}

<div class="container my-5">

    <div class="mb-4">
        <h1>Edit Profile</h1>
        <p class="text-muted">
            Update your profile information.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form action="/Student/Profile/Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="Id"
                       value="@Model.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label for="FirstName" class="form-label">
                        First Name
                    </label>

                    <input type="text"
                           id="FirstName"
                           name="FirstName"
                           value="@Model.FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="LastName" class="form-label">
                        Last Name
                    </label>

                    <input type="text"
                           id="LastName"
                           name="LastName"
                           value="@Model.LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label">
                        Email
                    </label>

                    <input type="email"
                           id="Email"
                           name="Email"
                           value="@Model.Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="ContactNumber" class="form-label">
                        Contact Number
                    </label>

                    <input type="text"
                           id="ContactNumber"
                           name="ContactNumber"
                           value="@Model.ContactNumber"
                           class="form-control" />

                    <span asp-validation-for="ContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="LanguageId" class="form-label">
                        Language ID
                    </label>

                    <input type="number"
                           id="LanguageId"
                           name="LanguageId"
                           value="@Model.LanguageId"
                           class="form-control" />

                    <span asp-validation-for="LanguageId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="LinkedInProfile" class="form-label">
                        LinkedIn Profile
                    </label>

                    <input type="url"
                           id="LinkedInProfile"
                           name="LinkedInProfile"
                           value="@Model.LinkedInProfile"
                           class="form-control" />

                    <span asp-validation-for="LinkedInProfile"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a href="/Student/Profile"
                       class="btn btn-secondary">
                        Back
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}