@model Aotearoa_is_Home.Models.ViewModels.ApproveStudentRegistrationViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Approve Student Registration";
}

<div class="student-approval-page">

    <div class="student-approval-header">

        <div>
            <div class="student-management-label">
                STUDENT MANAGEMENT
            </div>

            <h1>Approve Student Registration</h1>

            <p>
                Confirm the student's details and create their account.
            </p>
        </div>

        <a href="/Admin/StudentRegistration/Review/@Model.Id" class="back-dashboard-button">
            ← Back to Review
        </a>

    </div>


    <div class="approval-form-card">

        <div class="approval-student-header">

            <div class="approval-avatar">
                @(string.IsNullOrWhiteSpace(Model.FirstName)
                    ? "?"
                    : Model.FirstName.Substring(0, 1).ToUpper())
            </div>

            <div>
                <h2>
                    @Model.FirstName @Model.LastName
                </h2>

                <p>
                    @Model.Email
                </p>
            </div>

        </div>


        <div class="approval-divider"></div>


        <form asp-action="Approve"
              asp-controller="StudentRegistration"
              asp-area="Admin"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input asp-for="FirstName" type="hidden" />
            <input asp-for="LastName" type="hidden" />
            <input asp-for="Email" type="hidden" />


            <div class="approval-form-grid">

                <div class="approval-field">
                    <label for="StudentId">
                        Student ID
                        <span class="optional-label">(optional)</span>
                    </label>

                    <input type="text"
                        id="StudentId"
                        name="StudentId"
                        value="@Model.StudentId"
                        class="form-control"
                        placeholder="Enter Student ID if available" />

                    @if (ViewData.ModelState["StudentId"]?.Errors.Count > 0)
                    {
                        <div class="approval-validation-error">
                            @foreach (var error in ViewData.ModelState["StudentId"].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                </div>

                <div class="approval-field">
                    <label for="TemporaryPassword">
                        Temporary Password
                        <span class="required-star">*</span>
                    </label>

                    <input type="password"
                        id="TemporaryPassword"
                        name="TemporaryPassword"
                        class="form-control"
                        placeholder="Enter a temporary password" />

                    @if (ViewData.ModelState["TemporaryPassword"]?.Errors.Count > 0)
                    {
                        <div class="approval-validation-error">
                            @foreach (var error in ViewData.ModelState["TemporaryPassword"].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                </div>

                <div class="approval-field">
                    <label for="ConfirmTemporaryPassword">
                        Confirm Temporary Password
                        <span class="required-star">*</span>
                    </label>

                    <input type="password"
                        id="ConfirmTemporaryPassword"
                        name="ConfirmTemporaryPassword"
                        value=""
                        class="form-control"
                        placeholder="Re-enter the temporary password"
                        autocomplete="new-password" />

                    <div class="approval-validation-error">
                        @if (ViewData.ModelState["ConfirmTemporaryPassword"]?.Errors.Count > 0)
                        {
                            foreach (var error in ViewData.ModelState["ConfirmTemporaryPassword"].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        }
                    </div>
                </div>
            </div>

            @if (ViewBag.InactiveStudentWarning != null)
            {
                <div class="admin-approval-warningA">

                    <div class="admin-approval-icon">
                        !
                    </div>

                    <div class="admin-approval-content">
                        <h3>Administrator approval</h3>

                        <p>
                            @ViewBag.InactiveStudentWarning
                        </p>
                    </div>

                </div>
            }


            @if (string.IsNullOrWhiteSpace(Model.StudentId))
            {
                <div class="admin-approval-warning">

                    <div class="admin-approval-icon">
                        !
                    </div>

                    <div class="admin-approval-content">
                        <h3>Administrator approval</h3>

                        <p>
                            This student does not currently have a Student ID.
                            You can approve the registration and create the student account without a Student ID.
                        </p>
                    </div>

                </div>
            }


            <div class="approval-actions">

                <a href="/Admin/StudentRegistration/Review/@Model.Id" class="approval-cancel-button">
                    ← Cancel
                </a>

                <button type="submit"   class="approve-account-button">
                    Approve &amp; Create Account
                </button>

            </div>

        </form>

    </div>

</div>



@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}