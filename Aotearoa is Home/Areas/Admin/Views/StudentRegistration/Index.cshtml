@model List<Aotearoa_is_Home.Models.PendingStudentRegistration>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pending Student Registrations";

    var currentSearch = ViewBag.Search as string ?? "";
    var currentFilter = ViewBag.Filter as string ?? "";
    var currentFromDate = ViewBag.FromDate as string ?? "";
    var currentToDate = ViewBag.ToDate as string ?? "";
}

<div class="admin-registration-page">

    <!-- HEADER -->
    <div class="admin-registration-header">

        <div>
            <span class="admin-registration-eyebrow">
                STUDENT MANAGEMENT
            </span>

            <h1>Student Request</h1>

            <p>
                Review student registration requests submitted for administrator approval.
            </p>
        </div>

        <a href="/Admin/Home" class="admin-back-button">
            ← Back to Dashboard
        </a>

    </div>


    <div class="admin-registration-content">

        <!-- FILTER PANEL -->
        <div class="admin-registration-filter-panel">

            <div class="admin-filter-heading">

                <div>
                    <span class="admin-registration-eyebrow">
                        FILTER REQUESTS
                    </span>

                </div>

            </div>


            <form method="get"
                  action="/Admin/StudentRegistration/Index"
                  class="admin-registration-filter-form">

                <!-- SEARCH -->
                <div class="admin-filter-group admin-filter-search">

                    <label for="search">
                        Search
                    </label>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@currentSearch"
                           class="admin-modern-input"
                           placeholder="Name, email or Student ID..." />

                </div>


                <!-- STATUS -->
                <div class="admin-filter-group">

                    <label for="filter">
                        Request Type
                    </label>

                    <select id="filter"
                            name="filter"
                            class="admin-modern-input">

                        <option value=""
                                selected="@(string.IsNullOrEmpty(currentFilter))">
                            All Requests
                        </option>

                        <option value="new"
                                selected="@(currentFilter == "new")">
                            New Users
                        </option>

                        <option value="inactive"
                                selected="@(currentFilter == "inactive")">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- FROM DATE -->
                <div class="admin-filter-group">

                    <label for="fromDate">
                        From Date
                    </label>

                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@currentFromDate"
                           class="admin-modern-input" />

                </div>


                <!-- TO DATE -->
                <div class="admin-filter-group">

                    <label for="toDate">
                        To Date
                    </label>

                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@currentToDate"
                           class="admin-modern-input" />

                </div>


                <!-- BUTTONS -->
                <div class="admin-filter-actions">

                    <button type="submit"
                            class="admin-filter-button">
                        Apply Filters
                    </button>

                    <a href="/Admin/StudentRegistration/Index"
                       class="admin-clear-filter-button">
                        Clear
                    </a>

                </div>

            </form>

        </div>

        @if (TempData["RegistrationSuccess"] != null)
        {
            <div class="registration-success-alert">
                <span class="registration-alert-icon">✓</span>

                <div>
                    <strong>Registration approved</strong>
                    <p>@TempData["RegistrationSuccess"]</p>
                </div>
            </div>
        }

        @if (TempData["RegistrationError"] != null)
        {
            <div class="registration-error-alert">
                <span class="registration-alert-icon">!</span>

                <div>
                    <strong>Registration error</strong>
                    <p>@TempData["RegistrationError"]</p>
                </div>
            </div>
        }
        
        <!-- RESULTS -->
        @if (!Model.Any())
        {
            <div class="admin-registration-empty">

                <div class="admin-registration-empty-icon">
                    ✓
                </div>

                <h2>No Registrations Found</h2>

                <p>
                    No student registration requests match the current filters.
                </p>

                <a href="/Admin/StudentRegistration/Index"
                   class="admin-review-button"
                   style="display:inline-block; margin-top:20px;">
                    Clear Filters
                </a>

            </div>
        }
        else
        {
            <!-- SUMMARY -->
            <div class="admin-registration-summary">

                <div>

                    <span class="admin-summary-label">
                        MATCHING REQUESTS
                    </span>

                    <strong>
                        @Model.Count
                    </strong>

                </div>

                <div class="admin-summary-description">
                    Registration requests requiring administrator review
                </div>

            </div>


            <!-- REGISTRATION LIST -->
            <div class="admin-registration-list">

                @foreach (var registration in Model)
                {
                    <div class="admin-registration-card">

                        <div class="admin-registration-card-main">

                            <!-- AVATAR -->
                            <div class="admin-registration-avatar">

                                @{
                                    var avatarLetter =
                                        !string.IsNullOrWhiteSpace(registration.FirstName)
                                            ? registration.FirstName
                                                .Trim()
                                                .Substring(0, 1)
                                                .ToUpper()
                                            : "?";
                                }

                                @avatarLetter

                            </div>


                            <!-- DETAILS -->
                            <div class="admin-registration-details">

                                <div class="admin-registration-name-row">

                                    <h2>
                                        @registration.FirstName
                                        @registration.LastName
                                    </h2>

                                    @if (string.IsNullOrWhiteSpace(registration.StudentId))
                                    {
                                        <span class="admin-pending-badge">
                                            New User
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-pending-badge">
                                            Pending
                                        </span>
                                    }

                                </div>


                                <div class="admin-registration-info">

                                    <!-- EMAIL -->
                                    <div class="admin-registration-info-item">

                                        <span class="info-label">
                                            EMAIL
                                        </span>

                                        <span class="info-value">
                                            @registration.Email
                                        </span>

                                    </div>


                                    <!-- STUDENT ID -->
                                    <div class="admin-registration-info-item">

                                        <span class="info-label">
                                            STUDENT ID
                                        </span>

                                        <span class="info-value">

                                            @if (string.IsNullOrWhiteSpace(registration.StudentId))
                                            {
                                                <span class="not-provided">
                                                    Not provided yet
                                                </span>
                                            }
                                            else
                                            {
                                                @registration.StudentId
                                            }

                                        </span>

                                    </div>


                                    <!-- SUBMITTED -->
                                    <div class="admin-registration-info-item">

                                        <span class="info-label">
                                            SUBMITTED
                                        </span>

                                        <span class="info-value">
                                            @registration.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ACTION -->
                        <div class="admin-registration-actions">

                            <a href="/Admin/StudentRegistration/Review/@registration.Id"
                               class="admin-review-button">

                                Review

                            </a>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>