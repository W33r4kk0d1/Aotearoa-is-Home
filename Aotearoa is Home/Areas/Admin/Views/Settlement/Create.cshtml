@model Aotearoa_is_Home.Models.SettlementPage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Settlement Information";
}

<div class="admin-create-page">

    <!-- Page Header -->
    <div class="admin-create-header">
        <div>
            <span class="admin-eyebrow">SETTLEMENT CONTENT</span>
            <h1>Create Settlement Category</h1>
            <p>
                Create a new information hub with useful resources for students and families settling in Aotearoa New Zealand.
            </p>
        </div>

        <a href="/Admin/Home"
            class="admin-back-button">
                ← Back to Dashboard
            </a>

    </div>


    <form id="settlementForm"
          asp-area="Admin"
          asp-controller="Settlement"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="admin-validation-summary">
        </div>


        <!-- Category Details -->
        <section class="admin-create-section">

            <div class="admin-create-section-header">

                <div>
                    <span class="admin-section-number">01</span>

                    <div>
                        <h2>Category Details</h2>

                        <p>
                            Give your settlement information hub a clear name
                            and optional background image.
                        </p>
                    </div>
                </div>

            </div>


            <div class="admin-create-section-body">

                <!-- Category Name -->
                <div class="admin-field">

                    <label for="CategoryName">
                        Category Hub Name
                        <span class="admin-required">*</span>
                    </label>

                    <input type="text"
                           id="CategoryName"
                           name="CategoryName"
                           class="admin-modern-input"
                           placeholder="e.g., Accommodation"
                           required />

                    <span asp-validation-for="CategoryName"
                          class="admin-field-error">
                    </span>

                </div>


                <!-- Background Image -->
                <div class="admin-field">

                    <label for="backgroundImage">
                        Category Background Image
                    </label>

                    <p class="admin-field-help">
                        Add an image to visually represent this settlement category.
                    </p>

                    <div class="admin-file-upload">

                        <input type="file"
                               id="backgroundImage"
                               name="backgroundImage"
                               accept="image/*" />

                        <span class="admin-file-note">
                            JPG, PNG or other supported image format
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- Topic Cards -->
        <section class="admin-create-section">

            <div class="admin-create-section-header topic-section-header">

                <div class="admin-section-title-wrapper">

                    <span class="admin-section-number">02</span>

                    <div>
                        <h2>Topic Cards</h2>

                        <p>
                            Add sections of information that visitors can
                            explore within this category.
                        </p>
                    </div>

                </div>

                <span class="admin-topic-counter"
                      id="cardCounter">
                    0 Topic Cards
                </span>

            </div>


            <div class="admin-topic-section-body">

                <div id="topicCardsContainer"
                     class="admin-topic-cards-container">
                </div>


                <!-- Empty Topic State -->
                <div id="topicCardsEmptyState"
                     class="admin-topic-empty">

                    <div class="admin-topic-empty-icon">
                        +
                    </div>

                    <h3>No Topic Cards Yet</h3>

                    <p>
                        Add topic cards to organise the information
                        visitors will see on this settlement page.
                    </p>

                </div>


                <div class="admin-add-topic-wrapper">

                    <button type="button"
                            onclick="createNewTopicCard()"
                            class="admin-add-topic-button">

                        <span>+</span>
                        Add Topic Card

                    </button>

                </div>

            </div>

        </section>


        <!-- Publish Actions -->
        <div class="admin-create-actions">

            <a href="/Admin/Home" class="admin-back-button">
                Cancel
            </a>

            <button type="submit"
                    class="admin-publish-button">

                Publish Settlement Information

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <script>

        let cardCount = 0;

        function createNewTopicCard() {

            const container =
                document.getElementById("topicCardsContainer");

            const emptyState =
                document.getElementById("topicCardsEmptyState");

            if (emptyState) {
                emptyState.style.display = "none";
            }

            const cardId =
                `topic-card-${cardCount}`;

            const topicCard =
                document.createElement("div");

            topicCard.className =
                "card border-start border-primary border-4 shadow-sm topic-card bg-white mb-3";

            topicCard.id = cardId;

            topicCard.innerHTML = `
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">

                            <span class="badge bg-primary text-uppercase font-monospace">
                                Topic Card
                            </span>

                            <button type="button"
                                    onclick="document.getElementById('${cardId}').remove(); reIndexAllInputs();"
                                    class="btn btn-outline-danger btn-sm py-0 px-2">
                                Delete Card
                            </button>

                        </div>

                        <div class="card-body p-3">

                            <div class="mb-3 border-bottom pb-3">

                                <label class="form-label small text-uppercase fw-bold text-secondary">
                                    Card Heading / Section Title
                                </label>

                                <input type="text"
                                       class="form-control fw-bold card-heading-input"
                                       placeholder="e.g., Finding Accommodation..."
                                       required />

                            </div>

                            <div class="nested-items-container d-flex flex-column gap-2 mb-3">
                            </div>

                            <div class="bg-light p-2 rounded border d-flex gap-2 align-items-center">

                                <select class="form-select form-select-sm nested-type-select"
                                        style="max-width: 200px;">

                                    <option value="">
                                        Add details to card...
                                    </option>

                                    <option value="subheading">
                                        Subheading
                                    </option>

                                    <option value="paragraph">
                                        Paragraph Text
                                    </option>

                                    <option value="image">
                                        Image
                                    </option>

                                    <option value="link">
                                        Link URL
                                    </option>

                                </select>

                                <button type="button"
                                        onclick="addNestedElement('${cardId}')"
                                        class="btn btn-outline-primary btn-sm fw-bold">
                                    + Add Detail
                                </button>

                            </div>

                        </div>
                    `;

            container.appendChild(topicCard);

            cardCount++;

            reIndexAllInputs();
        }


        function addNestedElement(cardId) {

            const card =
                document.getElementById(cardId);

            const typeSelect =
                card.querySelector(".nested-type-select");

            const selectedType =
                typeSelect.value;

            if (selectedType === "") {

                alert("Please select a detail type to add.");

                return;
            }

            const nestedContainer =
                card.querySelector(".nested-items-container");

            const elementRow =
                document.createElement("div");

            elementRow.className =
                "nested-item-row p-2 border rounded bg-white shadow-xs d-flex flex-column gap-1";

            elementRow.setAttribute(
                "data-type",
                selectedType
            );

            let inputHtml = "";

            let badgeColor = "bg-secondary";


            if (selectedType === "subheading") {

                badgeColor = "bg-info text-dark";

                inputHtml = `
                            <input type="text"
                                   class="form-control form-control-sm item-content-field"
                                   placeholder="Enter subheading text..."
                                   required>
                        `;
            }


            else if (selectedType === "paragraph") {

                badgeColor = "bg-secondary text-white";

                inputHtml = `
                            <textarea class="form-control form-control-sm item-content-field"
                                      rows="2"
                                      placeholder="Enter text details..."
                                      required></textarea>
                        `;
            }


            else if (selectedType === "image") {

                badgeColor = "bg-warning text-dark";

                inputHtml = `
                            <input type="text"
                                   class="form-control form-control-sm item-content-field"
                                   placeholder="Paste image URL...">
                        `;
            }


            else if (selectedType === "link") {

                badgeColor = "bg-dark text-white";

                inputHtml = `
                            <div class="row g-2">

                                <div class="col-sm-5">

                                    <input type="text"
                                           class="form-control form-control-sm item-link-text-field"
                                           placeholder="Link Display Text"
                                           required>

                                </div>

                                <div class="col-sm-7">

                                    <input type="url"
                                           class="form-control form-control-sm item-link-url-field"
                                           placeholder="https://..."
                                           required>

                                </div>

                            </div>

                            <input type="hidden"
                                   class="item-content-field"
                                   value="">
                        `;
            }


            elementRow.innerHTML = `

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-1">

                            <span class="badge ${badgeColor} text-uppercase px-1 py-0 font-monospace"
                                  style="font-size:0.7rem;">
                                ${selectedType}
                            </span>

                            <button type="button"
                                    onclick="this.closest('.nested-item-row').remove(); reIndexAllInputs();"
                                    class="btn-close"
                                    style="font-size:0.65rem;"
                                    aria-label="Close">
                            </button>

                        </div>

                        <div>
                            ${inputHtml}
                        </div>
                    `;


            if (selectedType === "link") {

                const textIn =
                    elementRow.querySelector(
                        ".item-link-text-field"
                    );

                const urlIn =
                    elementRow.querySelector(
                        ".item-link-url-field"
                    );

                const contentIn =
                    elementRow.querySelector(
                        ".item-content-field"
                    );

                const syncContent = () => {

                    contentIn.value =
                        `${textIn.value.trim()}||${urlIn.value.trim()}`;
                };

                textIn.addEventListener(
                    "input",
                    syncContent
                );

                urlIn.addEventListener(
                    "input",
                    syncContent
                );
            }


            nestedContainer.appendChild(
                elementRow
            );

            typeSelect.value = "";

            reIndexAllInputs();
        }


        function reIndexAllInputs() {

            const topicCards =
                document.querySelectorAll(
                    "#topicCardsContainer .topic-card"
                );

            let overallIndex = 0;


            topicCards.forEach((card) => {

                const headingInput =
                    card.querySelector(
                        ".card-heading-input"
                    );


                let headingType =
                    card.querySelector(
                        ".card-heading-type-hidden"
                    );

                if (!headingType) {

                    headingType =
                        document.createElement("input");

                    headingType.type = "hidden";

                    headingType.className =
                        "card-heading-type-hidden";

                    headingType.value =
                        "heading";

                    card.appendChild(
                        headingType
                    );
                }


                let headingOrder =
                    card.querySelector(
                        ".card-heading-order-hidden"
                    );

                if (!headingOrder) {

                    headingOrder =
                        document.createElement("input");

                    headingOrder.type = "hidden";

                    headingOrder.className =
                        "card-heading-order-hidden";

                    card.appendChild(
                        headingOrder
                    );
                }


                headingType.name =
                    `ContentBlocks[${overallIndex}].Type`;

                headingOrder.name =
                    `ContentBlocks[${overallIndex}].DisplayOrder`;

                headingOrder.value =
                    overallIndex;

                headingInput.name =
                    `ContentBlocks[${overallIndex}].Content`;

                overallIndex++;


                const nestedItems =
                    card.querySelectorAll(
                        ".nested-item-row"
                    );


                nestedItems.forEach((row) => {

                    const itemType =
                        row.getAttribute(
                            "data-type"
                        );

                    const contentField =
                        row.querySelector(
                            ".item-content-field"
                        );


                    let typeHidden =
                        row.querySelector(
                            ".row-type-hidden"
                        );

                    if (!typeHidden) {

                        typeHidden =
                            document.createElement("input");

                        typeHidden.type =
                            "hidden";

                        typeHidden.className =
                            "row-type-hidden";

                        typeHidden.value =
                            itemType;

                        row.appendChild(
                            typeHidden
                        );
                    }


                    let orderHidden =
                        row.querySelector(
                            ".row-order-hidden"
                        );

                    if (!orderHidden) {

                        orderHidden =
                            document.createElement("input");

                        orderHidden.type =
                            "hidden";

                        orderHidden.className =
                            "row-order-hidden";

                        row.appendChild(
                            orderHidden
                        );
                    }


                    typeHidden.name =
                        `ContentBlocks[${overallIndex}].Type`;

                    orderHidden.name =
                        `ContentBlocks[${overallIndex}].DisplayOrder`;

                    orderHidden.value =
                        overallIndex;

                    contentField.name =
                        `ContentBlocks[${overallIndex}].Content`;

                    overallIndex++;
                });

            });


            const badge =
                document.getElementById(
                    "cardCounter"
                );

            if (badge) {

                badge.innerText =
                    `${topicCards.length} Topic Cards Active`;
            }
        }


        $(document).ready(function() {

            reIndexAllInputs();


            $("#settlementForm").on(
                "submit",
                function(event) {

                    event.preventDefault();

                    const formElement =
                        this;


                    if (!formElement.checkValidity()) {

                        formElement.reportValidity();

                        return;
                    }


                    const categoryInput =
                        $("#CategoryName");


                    const categoryValue =
                        categoryInput.val().trim();


                    reIndexAllInputs();


                    const headings =
                        $(".card-heading-input");


                    const uniqueHeadings =
                        [];

                    let duplicateFound =
                        false;


                    headings.each(function() {

                        const value =
                            $(this)
                                .val()
                                .trim()
                                .toLowerCase();


                        if (
                            value !== "" &&
                            uniqueHeadings.includes(value)
                        ) {

                            alert(
                                `Validation Error: You cannot enter the same Topic Card Heading twice: "${$(this).val()}"`
                            );

                            $(this)
                                .addClass("is-invalid")
                                .focus();

                            duplicateFound =
                                true;

                            return false;
                        }


                        if (value !== "") {

                            uniqueHeadings.push(
                                value
                            );

                            $(this)
                                .removeClass(
                                    "is-invalid"
                                );
                        }

                    });


                    if (duplicateFound) {
                        return;
                    }


                    $.ajax({

                        url:
                            '@Url.Action("IsCategoryUnique", "Settlement", new { area = "Admin" })',

                        type:
                            "GET",

                        data:
                        {
                            categoryName:
                                categoryValue
                        },

                        success:
                            function(isUnique) {

                                if (!isUnique) {

                                    categoryInput
                                        .addClass(
                                            "is-invalid"
                                        )
                                        .focus();

                                    alert(
                                        `The settlement category "${categoryValue}" already exists.`
                                    );

                                    return;
                                }


                                HTMLFormElement.prototype.submit.call(
                                    formElement
                                );
                            },

                        error:
                            function() {

                                HTMLFormElement.prototype.submit.call(
                                    formElement
                                );
                            }

                    });

                }
            );

        });

    </script>

}
