@model List<Aotearoa_is_Home.Models.SettlementPage>

@using System.Text.Encodings.Web

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Settlement Management";
}

<div class="admin-dashboard">

    <!-- Dashboard Header -->
    <div class="admin-dashboard-header">

        <div class="admin-dashboard-heading">
            <span class="admin-eyebrow">SETTLEMENT CONTENT</span>

            <h1>Settlement Management</h1>

            <p>
                Manage settlement information, resources and public content.
            </p>
        </div>

        <a href="/Admin/Settlement/Create"
           class="admin-primary-button">
            <span class="admin-button-icon">+</span>
            Create New Category
        </a>

    </div>


    <!-- Dashboard Content -->
    <section class="admin-content-section">

        <div class="admin-section-heading">

            <div>
                <h2>Settlement Hubs</h2>

                <p>
                    Create and manage information categories displayed to users.
                </p>
            </div>

            @if (Model != null && Model.Any())
            {
                <span class="admin-count-badge">
                    @Model.Count @(Model.Count == 1 ? "Category" : "Categories")
                </span>
            }

        </div>


        @if (Model == null || !Model.Any())
        {
            <!-- Empty State -->
            <div class="admin-empty-state">

                <div class="admin-empty-icon">
                    +
                </div>

                <h3>No Settlement Hubs Yet</h3>

                <p>
                    Create your first settlement information category to start building the public information hub.
                </p>

                <a href="/Admin/Settlement/Create"
                   class="admin-secondary-button">
                    Create Your First Category
                </a>

            </div>
        }
        else
        {
            <!-- Category Grid -->

            <div class="admin-category-grid">

                @foreach (var settlementPage in Model)
                {
                    <article class="admin-category-card">

                        <!-- Card Header -->
                        <div class="admin-category-card-top">

                            <span class="admin-category-label">
                                SETTLEMENT HUB
                            </span>

                            <div class="admin-category-icon">
                                +
                            </div>

                        </div>


                        <!-- Category Content -->
                        <a href="/Admin/Settlement/View/@settlementPage.Id"
                           class="admin-category-content">

                            <h3>
                                @settlementPage.CategoryName
                            </h3>

                            <p>
                                Settlement information and resources
                            </p>

                            <span class="admin-view-link">
                                View category →
                            </span>

                        </a>


                        <!-- Actions -->
                        <div class="admin-category-actions">

                            <a href="/Admin/Settlement/Edit/@settlementPage.Id"
                               class="admin-edit-button">
                                Edit
                            </a>

                            <button type="button"
                                    class="admin-delete-button"
                                    onclick="confirmDelete(
                                        '@settlementPage.Id',
                                        '@JavaScriptEncoder.Default.Encode(settlementPage.CategoryName)'
                                    )">
                                Delete
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>


<!-- Delete Confirmation Modal -->

<div class="modal fade"
     id="deleteConfirmationModal"
     data-bs-backdrop="static"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header bg-danger text-white py-3">

                <h5 class="modal-title fw-bold d-flex align-items-center gap-2"
                    id="deleteModalLabel">

                    <span>⚠️</span>
                    Permanent Deletion Warning

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>


            <div class="modal-body p-4 text-center">

                <div class="text-danger display-4 mb-3">
                    🗑️
                </div>

                <p class="fs-5 text-dark mb-1 fw-semibold">
                    Are you sure you want to delete this content?
                </p>

                <h4 class="fw-bold text-danger border border-danger bg-light p-3 rounded my-3 text-break"
                    id="deleteTargetCategoryName">
                    Category Name
                </h4>

                <p class="text-muted small mb-0">
                    This action cannot be undone. All nested topic cards, paragraph sections, links, and media files under this category will be erased from the database.
                </p>

            </div>


            <div class="modal-footer bg-light p-3 border-top">

                <div class="row w-100 g-2 m-0">

                    <div class="col-6 p-0 pe-1">

                        <button type="button"
                                class="btn btn-secondary w-100 fw-bold py-2"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                    </div>

                    <div class="col-6 p-0 ps-1">

                        <form id="deleteConfirmedForm"
                              method="post"
                              action=""
                              class="w-100 m-0">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger w-100 fw-bold py-2">
                                Confirm Delete
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function confirmDelete(id, name) {

            document.getElementById("deleteTargetCategoryName").innerText = name;

            document.getElementById("deleteConfirmedForm").action =
                `/Admin/Settlement/Delete/${id}`;

            const deleteModal =
                new bootstrap.Modal(
                    document.getElementById("deleteConfirmationModal")
                );

            deleteModal.show();
        }

    </script>
}