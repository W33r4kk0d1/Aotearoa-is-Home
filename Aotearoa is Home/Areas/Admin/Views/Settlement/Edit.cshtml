@model Aotearoa_is_Home.Models.SettlementPage
@using System.Text.Encodings.Web

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Settlement Information";
}

<div class="admin-edit-page">

    <!-- Page Header -->
    <div class="admin-edit-header">
        <div>
            <span class="admin-eyebrow">SETTLEMENT CONTENT</span>
            <h1>Edit Settlement Category</h1>
            <p>
                Update the category name and manage the information cards available to visitors.
            </p>
        </div>

        <a href="/Admin/Home"
           class="admin-back-button">
            ← Back to Dashboard
        </a>

    </div>


    <form id="settlementForm"
          asp-area="Admin"
          asp-controller="Settlement"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <div asp-validation-summary="ModelOnly"
             class="admin-validation-summary">
        </div>


        <!-- =====================================================
             01 - CATEGORY DETAILS
             ===================================================== -->

        <section class="admin-create-section">
            <div class="admin-create-section-header">
                <div>
                    <span class="admin-section-number">
                        01
                    </span>
                    <div>
                        <h2>
                            Category Details
                        </h2>
                        <p>
                            Update the name of this settlement information hub.
                        </p>
                    </div>
                </div>
            </div>


            <div class="admin-create-section-body">
                <div class="admin-field">
                    <label for="CategoryName">
                        Category Hub Name
                        <span class="admin-required">
                            *
                        </span>
                    </label>

                    <input type="text"
                           id="CategoryName"
                           name="CategoryName"
                           value="@Model.CategoryName"
                           class="admin-modern-input"
                           required />

                    <span asp-validation-for="CategoryName"
                          class="admin-field-error">
                    </span>
                </div>
            </div>
        </section>


        @* TOPIC CARDS *@

        <section class="admin-create-section">

            <div class="admin-create-section-header topic-section-header">
                <div class="admin-section-title-wrapper">
                    <span class="admin-section-number">
                        02
                    </span>
                    <div>
                        <h2>
                            Topic Cards
                        </h2>
                        <p>
                            Edit existing information or add new topic cards.
                        </p>
                    </div>
                </div>

                <span class="admin-topic-counter"
                      id="cardCounter">
                    0 Topic Cards Active
                </span>
            </div>

            <div class="admin-topic-section-body">
                <div id="topicCardsContainer" class="admin-topic-cards-container">
                    @{
                        int serverCardIndex = 0;
                        bool hasTopicCards = false;
                    }

                    @foreach (var block in Model.ContentBlocks.OrderBy(b => b.DisplayOrder))
                    {
                        @if (block.Type == "heading")
                        {
                            hasTopicCards = true;

                            <div id="topic-card-@serverCardIndex"
                                 class="admin-edit-topic-card topic-card">

                                <!-- Topic Card Header -->
                                <div class="admin-edit-topic-header">
                                    <span class="admin-topic-label">
                                        TOPIC CARD
                                    </span>

                                    <button type="button"
                                            onclick="document.getElementById('topic-card-@serverCardIndex').remove(); reIndexAllInputs();"
                                            class="admin-topic-delete">

                                        Delete Card
                                    </button>
                                </div>

                                <!-- Topic Card Body -->

                                <div class="admin-edit-topic-body">

                                    <!-- Card Heading -->

                                    <div class="admin-topic-heading">
                                        <label class="admin-topic-field-label">
                                            Card Heading / Section Title
                                        </label>

                                        <input type="text"
                                               class="admin-modern-input fw-bold card-heading-input"
                                               value="@block.Content"
                                               placeholder="e.g., Finding Accommodation..."
                                               required />
                                    </div>


                                    <!-- Nested Details -->

                                    <div class="nested-items-container d-flex flex-column gap-2 mb-3">
                                        @foreach (var detail in Model.ContentBlocks
                                            .Where(b =>
                                                b.DisplayOrder > block.DisplayOrder &&
                                                b.Type != "heading")
                                            .OrderBy(b => b.DisplayOrder))
                                        {

                                            var nextHeadingExists =
                                                Model.ContentBlocks.Any(b =>
                                                    b.Type == "heading" &&
                                                    b.DisplayOrder > block.DisplayOrder &&
                                                    b.DisplayOrder < detail.DisplayOrder);

                                            @if (nextHeadingExists)
                                            {
                                                break;
                                            }

                                            <!-- SUBHEADING -->

                                            @if (detail.Type == "subheading")
                                            {
                                                <div class="nested-item-row admin-nested-item"
                                                     data-type="subheading">

                                                    <div class="admin-nested-item-header">
                                                        <span class="admin-content-type">
                                                            SUBHEADING
                                                        </span>

                                                        <button type="button"
                                                                onclick="this.closest('.nested-item-row').remove(); reIndexAllInputs();"
                                                                class="admin-nested-delete"
                                                                aria-label="Remove detail">
                                                            ×
                                                        </button>
                                                    </div>

                                                    <input type="text"
                                                           class="admin-modern-input item-content-field"
                                                           value="@detail.Content"
                                                           placeholder="Enter subheading text..."
                                                           required />
                                                </div>

                                            }

                                            else if (detail.Type == "paragraph")
                                            {

                                                <div class="nested-item-row admin-nested-item" data-type="paragraph">
                                                    <div class="admin-nested-item-header">
                                                        <span class="admin-content-type">
                                                            PARAGRAPH
                                                        </span>
                                                        <button type="button"
                                                                onclick="this.closest('.nested-item-row').remove(); reIndexAllInputs();"
                                                                class="admin-nested-delete"
                                                                aria-label="Remove detail">
                                                            ×
                                                        </button>
                                                    </div>

                                                    <textarea class="admin-modern-input item-content-field"
                                                              rows="3"
                                                              placeholder="Enter paragraph text..."
                                                              required>@detail.Content</textarea>
                                                </div>
                                            }

                                            else if (detail.Type == "image")
                                            {
                                                <div class="nested-item-row admin-nested-item" data-type="image">
                                                    <div class="admin-nested-item-header">
                                                        <span class="admin-content-type">
                                                            IMAGE
                                                        </span>

                                                        <button type="button"
                                                                onclick="this.closest('.nested-item-row').remove(); reIndexAllInputs();"
                                                                class="admin-nested-delete"
                                                                aria-label="Remove detail">
                                                            ×
                                                        </button>
                                                    </div>

                                                    <input type="text"
                                                           class="admin-modern-input item-content-field"
                                                           value="@detail.Content"
                                                           placeholder="Paste image asset URL..."
                                                           required />
                                                </div>
                                            }

                                            else if (detail.Type == "link")
                                            {
                                                var linkText = "Link";
                                                var linkUrl = detail.Content ?? "";

                                                if (!string.IsNullOrWhiteSpace(detail.Content)
                                                    && detail.Content.Contains("||"))
                                                {
                                                    var pieces =
                                                        detail.Content.Split("||", 2);

                                                    linkText = pieces[0];
                                                    linkUrl = pieces.Length > 1
                                                        ? pieces[1]
                                                        : "";
                                                }

                                                <div class="nested-item-row admin-nested-item" data-type="link">

                                                    <div class="admin-nested-item-header">
                                                        <span class="admin-content-type">
                                                            LINK
                                                        </span>
                                                        <button type="button"
                                                                onclick="this.closest('.nested-item-row').remove(); reIndexAllInputs();"
                                                                class="admin-nested-delete"
                                                                aria-label="Remove detail">
                                                            ×
                                                        </button>
                                                    </div>

                                                    <div class="row g-2">
                                                        <div class="col-sm-5">
                                                            <input type="text"
                                                                   class="form-control form-control-sm item-link-text-field"
                                                                   value="@linkText"
                                                                   placeholder="Link Display Text"
                                                                   required />
                                                        </div>

                                                        <div class="col-sm-7">

                                                            <input type="url"
                                                                   class="form-control form-control-sm item-link-url-field"
                                                                   value="@linkUrl"
                                                                   placeholder="https://..."
                                                                   required />
                                                        </div>
                                                    </div>

                                                    <input type="hidden"
                                                           class="item-content-field"
                                                           value="@detail.Content" />
                                                </div>
                                            }
                                        }
                                    </div>

                                    <!-- Add Detail -->

                                    <div class="admin-detail-controls">

                                        <select class="form-select form-select-sm nested-type-select">

                                            <option value="">
                                                Add details to card...
                                            </option>

                                            <option value="subheading">
                                                Subheading
                                            </option>

                                            <option value="paragraph">
                                                Paragraph Text
                                            </option>

                                            <option value="image">
                                                Image Asset URL
                                            </option>

                                            <option value="link">
                                                Link URL
                                            </option>
                                        </select>

                                        <button type="button"
                                                onclick="addNestedElement('topic-card-@serverCardIndex')"
                                                class="admin-detail-button">
                                            + Add Detail
                                        </button>
                                    </div>
                                </div>
                            </div>
                            serverCardIndex++;
                        }
                    }
                </div>


                @if (!hasTopicCards)
                {
                    <div class="admin-topic-empty">
                        <div class="admin-topic-empty-icon">
                            +
                        </div>
                        <h3>
                            No Topic Cards Yet
                        </h3>
                        <p>
                            Add topic cards to organise the information visitors will see on this settlement page.
                        </p>
                    </div>
                }


                <!-- Add New Topic Card -->

                <div class="admin-add-topic-wrapper">
                    <button type="button"
                            onclick="createNewTopicCard()"
                            class="admin-add-topic-button">
                        <span>
                            +
                        </span>
                        Add Topic Card
                    </button>
                </div>
            </div>
        </section>


        <!-- =====================================================
             FORM ACTIONS
             ===================================================== -->

        <div class="admin-edit-actions">
            <a href="/Admin/Home"
               class="admin-cancel-button">
                Cancel
            </a>

            <button type="submit"
                    class="admin-publish-button">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Initialize the card counter based on existing server-rendered topic cards
        let cardCount = document.querySelectorAll("#topicCardsContainer .topic-card").length + 1;

        function createNewTopicCard() {

            const container = document.getElementById("topicCardsContainer");
            const emptyState = document.querySelector(".admin-topic-empty");

            if (emptyState) {
                emptyState.style.display = "none";
            }

            const cardId = `topic-card-${cardCount}`;
            const topicCard = document.createElement("div");

            topicCard.className = "admin-edit-topic-card topic-card";
            topicCard.id = cardId;
            topicCard.innerHTML = `
                <!-- Topic Card Header -->

                <div class="admin-edit-topic-header">
                    <span class="admin-topic-label">
                        TOPIC CARD
                    </span>

                    <button type="button"
                            onclick="document.getElementById('${cardId}').remove(); reIndexAllInputs();"
                            class="admin-topic-delete">
                        Delete Card
                    </button>
                </div>

                <!-- Topic Card Body -->

                <div class="admin-edit-topic-body">
                    <div class="admin-topic-heading">
                        <label class="admin-topic-field-label">
                            Card Heading / Section Title
                        </label>
                        <input type="text"
                            class="admin-modern-input fw-bold card-heading-input"
                            placeholder="e.g., Finding Accommodation..."
                            required>
                    </div>

                    <!-- Nested Details -->

                    <div class="nested-items-container d-flex flex-column gap-2 mb-3">
                    </div>

                    <!-- Add Detail -->

                    <div class="admin-detail-controls">
                        <select class="form-select form-select-sm nested-type-select">
                            <option value=""> Add details to card... </option>
                            <option value="subheading"> Subheading </option>
                            <option value="paragraph"> Paragraph Text </option>
                            <option value="image"> Image Asset URL </option>
                            <option value="link"> Link URL </option>
                        </select>

                        <button type="button"
                                onclick="addNestedElement('${cardId}')"
                                class="admin-detail-button">
                            + Add Detail
                        </button>
                    </div>
                </div>
            `;


            container.appendChild(topicCard);
            cardCount++;
            reIndexAllInputs();
        }

       function addNestedElement(cardId) {

            const card = document.getElementById(cardId);
            const typeSelect = card.querySelector(".nested-type-select");
            const selectedType = typeSelect.value;

            if (selectedType === "") {
                alert("Please select a detail type to add.");
                return;
            }

            const nestedContainer = card.querySelector(".nested-items-container");
            const elementRow = document.createElement("div");
            elementRow.className = "nested-item-row admin-nested-item";
            elementRow.setAttribute(
                "data-type",
                selectedType
            );

            let inputHtml = "";

            if (selectedType === "subheading") {
                inputHtml = `
                    <input type="text"
                        class="admin-modern-input item-content-field"
                        placeholder="Enter subheading text..."
                        required>
                `;
            }

            else if (selectedType === "paragraph") {
                inputHtml = `
                    <textarea
                        class="admin-modern-input item-content-field"
                        rows="3"
                        placeholder="Enter paragraph text..."
                        required></textarea>
                `;
            }

            else if (selectedType === "image") {
                inputHtml = `
                    <input type="text"
                        class="admin-modern-input item-content-field"
                        placeholder="Paste image asset URL..."
                        required>
                `;
            }


            else if (selectedType === "link") {
                inputHtml = `
                    <div class="row g-2">
                        <div class="col-sm-5">
                            <input type="text"
                                class="form-control form-control-sm item-link-text-field"
                                placeholder="Link Display Text (e.g. More Info)"
                                required>
                        </div>

                        <div class="col-sm-7">
                            <input type="url"
                                class="form-control form-control-sm item-link-url-field"
                                placeholder="Paste full URL destination (https://...)"
                                required>
                        </div>
                    </div>

                    <input type="hidden"
                        class="item-content-field"
                        value="">
                `;
            }


            elementRow.innerHTML = `

                <div class="admin-nested-item-header">
                    <span class="admin-content-type">
                        ${selectedType}
                    </span>

                    <button type="button"
                            onclick="this.closest('.nested-item-row').remove(); reIndexAllInputs();"
                            class="admin-nested-delete"
                            aria-label="Remove detail">
                        ×
                    </button>
                </div>

                <div>
                    ${inputHtml}
                </div>
            `;


            if (selectedType === "link") {

                const textIn =
                    elementRow.querySelector(
                        ".item-link-text-field"
                    );
                const urlIn =
                    elementRow.querySelector(
                        ".item-link-url-field"
                    );
                const contentIn =
                    elementRow.querySelector(
                        ".item-content-field"
                    );
                const syncContent = () => {

                    contentIn.value =
                        `${textIn.value.trim()}||${urlIn.value.trim()}`;
                };

                textIn.addEventListener(
                    "input",
                    syncContent
                );

                urlIn.addEventListener(
                    "input",
                    syncContent
                );
            }


            nestedContainer.appendChild(
                elementRow
            );

            typeSelect.value = "";

            reIndexAllInputs();
        }

        function reIndexAllInputs() {
            const topicCards = document.querySelectorAll("#topicCardsContainer .topic-card");
            let overallIndex = 0;

            topicCards.forEach((card) => {
                const headingInput = card.querySelector(".card-heading-input");
                
                let headingType = card.querySelector(".card-heading-type-hidden");
                if (!headingType) {
                    headingType = document.createElement("input");
                    headingType.type = "hidden";
                    headingType.className = "card-heading-type-hidden";
                    headingType.value = "heading";
                    card.appendChild(headingType);
                }
                
                let headingOrder = card.querySelector(".card-heading-order-hidden");
                if (!headingOrder) {
                    headingOrder = document.createElement("input");
                    headingOrder.type = "hidden";
                    headingOrder.className = "card-heading-order-hidden";
                    card.appendChild(headingOrder);
                }

                headingType.name = `ContentBlocks[${overallIndex}].Type`;
                headingOrder.name = `ContentBlocks[${overallIndex}].DisplayOrder`;
                headingOrder.value = overallIndex;
                headingInput.name = `ContentBlocks[${overallIndex}].Content`;
                overallIndex++;

                const nestedItems = card.querySelectorAll(".nested-item-row");
                nestedItems.forEach((row) => {
                    const itemType = row.getAttribute("data-type");
                    const contentField = row.querySelector(".item-content-field");

                    let typeHidden = row.querySelector(".row-type-hidden");
                    if (!typeHidden) {
                        typeHidden = document.createElement("input");
                        typeHidden.type = "hidden";
                        typeHidden.className = "row-type-hidden";
                        typeHidden.value = itemType;
                        row.appendChild(typeHidden);
                    }

                    let orderHidden = row.querySelector(".row-order-hidden");
                    if (!orderHidden) {
                        orderHidden = document.createElement("input");
                        orderHidden.type = "hidden";
                        orderHidden.className = "row-order-hidden";
                        row.appendChild(orderHidden);
                    }

                    typeHidden.name = `ContentBlocks[${overallIndex}].Type`;
                    orderHidden.name = `ContentBlocks[${overallIndex}].DisplayOrder`;
                    orderHidden.value = overallIndex;
                    contentField.name = `ContentBlocks[${overallIndex}].Content`;
                    overallIndex++;
                });
            });

            const badge = document.getElementById("cardCounter");
            if (badge) {
                badge.innerText = `${topicCards.length} Topic Cards Active`;
            }
        }

        $(document).ready(function () {
            // Re-index immediately on page mount to properly structure server-rendered blocks
            reIndexAllInputs();

            $("#settlementForm").on("submit", function (event) {
                const formElement = this;

                if (!formElement.checkValidity()) {
                    formElement.reportValidity();
                    event.preventDefault();
                    return false;
                }

                const categoryInput = $("#CategoryName");
                categoryInput.removeClass("is-invalid");
                // Sync indices before executing the duplicate checks loop
                reIndexAllInputs();
                const headings = $(".card-heading-input");
                const uniqueHeadings = [];

                headings.each(function () {
                    const value = $(this).val().trim().toLowerCase();
                    if (uniqueHeadings.includes(value)) {
                        alert(`⚠️ Validation Error: You cannot enter the same Topic Card Heading twice: "${$(this).val()}"`);
                        $(this).addClass("is-invalid").focus();
                        hasError = true;
                        return false; 
                    }
                    if (value !== "") {
                        uniqueHeadings.push(value);
                        $(this).removeClass("is-invalid");
                    }
                });

                if (hasError) {
                    event.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
