@model Aotearoa_is_Home.Models.SettlementPage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Settlement Information";
}

<div class="container admin-container">

    <h1>Edit Settlement Information</h1>

    <form asp-area="Admin"
          asp-controller="Settlement"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          id="editSettlementForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <div class="admin-form-group">

            <label for="CategoryName">
                Category Name
            </label>

            <input type="text"
                   id="CategoryName"
                   name="CategoryName"
                   value="@Model.CategoryName"
                   class="admin-form-input"
                   required />

        </div>

        <div class="admin-form-group">

            <label for="backgroundImage">
                Category Background Image
            </label>

            <input type="file"
                   id="backgroundImage"
                   name="backgroundImage"
                   class="admin-form-input"
                   accept="image/*" />

            @if (Model.BackgroundImage != null)
            {
                <div style="margin-top: 15px;">

                    <p>Current background image:</p>

                    <img src="/Admin/Settlement/BackgroundImage/@Model.Id"
                         style="max-width: 400px; border-radius: 10px;" />

                </div>
            }

        </div>

        <h2>Page Content</h2>

        <div id="contentBlocks">

            @foreach (var block in Model.ContentBlocks.OrderBy(b => b.DisplayOrder))
            {
                <div class="content-block">

                    <div class="content-block-header">

                        <strong>
                            @block.Type
                        </strong>

                        <button type="button"
                                class="remove-content-button">
                            Remove
                        </button>

                    </div>

                    <input type="hidden"
                           name="ContentBlocks[@block.DisplayOrder].Type"
                           value="@block.Type" />

                    <input type="hidden"
                           name="ContentBlocks[@block.DisplayOrder].DisplayOrder"
                           value="@block.DisplayOrder" />

                    @if (block.Type == "heading")
                    {
                        <input type="text"
                               name="ContentBlocks[@block.DisplayOrder].Content"
                               value="@block.Content"
                               class="admin-form-input"
                               placeholder="Enter heading..."
                               required />
                    }
                    else if (block.Type == "subheading")
                    {
                        <div class="admin-form-group">

                            <label>
                                Subheading
                            </label>

                            <input type="text"
                                   name="ContentBlocks[@block.DisplayOrder].Content"
                                   value="@block.Content"
                                   class="admin-form-input"
                                   placeholder="Enter subheading..."
                                   required />

                        </div>

                        <div class="admin-form-group">

                            <label>
                                Subheading Details
                            </label>

                            <textarea name="ContentBlocks[@block.DisplayOrder].Details"
                                      class="admin-form-input admin-textarea"
                                      placeholder="Enter the information that appears when this subheading is opened..."
                                      required>@block.Details</textarea>

                        </div>
                    }
                    else if (block.Type == "paragraph")
                    {
                        <textarea name="ContentBlocks[@block.DisplayOrder].Content"
                                  class="admin-form-input admin-textarea"
                                  placeholder="Enter paragraph..."
                                  required>@block.Content</textarea>
                    }
                    else if (block.Type == "image")
                    {
                        @if (block.ImageData != null)
                        {
                            <div style="margin-bottom: 15px;">

                                <p>Current image:</p>

                                <img src="/Admin/Settlement/ContentImage/@block.Id"
                                     style="max-width: 300px; border-radius: 10px;" />

                            </div>
                        }

                        <label>
                            Replace image
                        </label>

                        <input type="file"
                               name="contentImages"
                               class="admin-form-input"
                               accept="image/*" />
                    }

                </div>
            }

        </div>

        <div class="content-builder-controls">

            <select id="contentType"
                    class="admin-form-input">

                <option value="">
                    Add content...
                </option>

                <option value="heading">
                    Heading
                </option>

                <option value="subheading">
                    Subheading
                </option>

                <option value="paragraph">
                    Paragraph
                </option>

                <option value="image">
                    Image
                </option>

            </select>

            <button type="button"
                    id="addContentButton"
                    class="admin-create-button">
                + Add Content
            </button>

        </div>

        <div class="admin-form-actions">

            <button type="submit"
                    class="admin-save-button">
                Save Changes
            </button>

            <a asp-area="Admin"
               asp-controller="Home"
               asp-action="Index"
               class="admin-cancel-button">
                Cancel
            </a>

        </div>

    </form>

</div>

<script>

    let blockIndex = @Model.ContentBlocks.Count();

    function attachRemoveButton(block) {

        const removeButton =
            block.querySelector(".remove-content-button");

        if (removeButton) {

            removeButton.addEventListener("click", function () {

                block.remove();

            });

        }

    }

    function addContentBlock() {

        const contentType =
            document.getElementById("contentType").value;

        const container =
            document.getElementById("contentBlocks");

        if (contentType === "") {

            alert("Please select a content type.");

            return;

        }

        const block =
            document.createElement("div");

        block.className =
            "content-block";

        if (contentType === "heading") {

            block.innerHTML = `

                <div class="content-block-header">

                    <strong>
                        Heading
                    </strong>

                    <button type="button"
                            class="remove-content-button">

                        Remove

                    </button>

                </div>

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].Type"
                       value="heading">

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].DisplayOrder"
                       value="${blockIndex}">

                <input type="text"
                       name="ContentBlocks[${blockIndex}].Content"
                       class="admin-form-input"
                       placeholder="Enter heading..."
                       required>

            `;

        }

        else if (contentType === "subheading") {

            block.innerHTML = `

                <div class="content-block-header">

                    <strong>
                        Subheading
                    </strong>

                    <button type="button"
                            class="remove-content-button">

                        Remove

                    </button>

                </div>

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].Type"
                       value="subheading">

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].DisplayOrder"
                       value="${blockIndex}">

                <div class="admin-form-group">

                    <label>
                        Subheading
                    </label>

                    <input type="text"
                           name="ContentBlocks[${blockIndex}].Content"
                           class="admin-form-input"
                           placeholder="Enter subheading..."
                           required>

                </div>

                <div class="admin-form-group">

                    <label>
                        Subheading Details
                    </label>

                    <textarea name="ContentBlocks[${blockIndex}].Details"
                              class="admin-form-input admin-textarea"
                              placeholder="Enter the information that appears when this subheading is opened..."
                              required></textarea>

                </div>

            `;

        }

        else if (contentType === "paragraph") {

            block.innerHTML = `

                <div class="content-block-header">

                    <strong>
                        Paragraph
                    </strong>

                    <button type="button"
                            class="remove-content-button">

                        Remove

                    </button>

                </div>

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].Type"
                       value="paragraph">

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].DisplayOrder"
                       value="${blockIndex}">

                <textarea name="ContentBlocks[${blockIndex}].Content"
                          class="admin-form-input admin-textarea"
                          placeholder="Enter paragraph..."
                          required></textarea>

            `;

        }

        else if (contentType === "image") {

            block.innerHTML = `

                <div class="content-block-header">

                    <strong>
                        Image
                    </strong>

                    <button type="button"
                            class="remove-content-button">

                        Remove

                    </button>

                </div>

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].Type"
                       value="image">

                <input type="hidden"
                       name="ContentBlocks[${blockIndex}].DisplayOrder"
                       value="${blockIndex}">

                <input type="file"
                       name="contentImages"
                       class="admin-form-input"
                       accept="image/*"
                       required>

            `;

        }

        container.appendChild(block);

        attachRemoveButton(block);

        blockIndex++;

        document.getElementById("contentType").value = "";

    }

    document.querySelectorAll(".content-block").forEach(function (block) {

        attachRemoveButton(block);

    });

    document.getElementById("addContentButton")
        .addEventListener("click", function () {

            addContentBlock();

        });

</script>