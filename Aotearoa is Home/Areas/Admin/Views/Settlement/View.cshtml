@model Aotearoa_is_Home.Models.SettlementPage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CategoryName;
}

<div class="admin-view-page">

    <div class="admin-view-header">

    <!-- LEFT SIDE -->
    <div class="admin-view-header-content">

        <span class="admin-eyebrow">
            SETTLEMENT HUB
        </span>

        <h1>
            @Model.CategoryName
        </h1>

        <p>
            View the information and resources available in this settlement category.
        </p>

                <div class="admin-view-header-actions">

            <a href="/Admin/Settlement"
               class="admin-back-button">
                ← Back to Dashboard
            </a>

            <a href="/Admin/Settlement/Edit/@Model.Id"
               class="admin-view-edit-button">
                ✏️ Edit Page
            </a>

        </div>

    </div>

    <!-- RIGHT SIDE - CATEGORY IMAGE -->
    @if (Model.BackgroundImage != null &&
         Model.BackgroundImage.Length > 0)
    {
        <div class="admin-view-category-image">

            <img src="data:@Model.BackgroundImageContentType;base64,@Convert.ToBase64String(Model.BackgroundImage)"
                 alt="@Model.CategoryName"
                 class="admin-view-category-image-img" />

        </div>
    }

    </div>
    <!-- ============== SEARCH ===================== -->

    <div class="admin-view-search">

        <div class="admin-search-wrapper">
            <span class="admin-search-icon">
                🔍
            </span>

            <input type="text"
                   id="topicSearchBar"
                   onkeyup="filterTopicsBySearch()"
                   class="admin-search-input"
                   placeholder="Search entries inside the @Model.CategoryName collection..."
                   aria-label="Search filter field input bar" />

            <button type="button"
                    id="clearSearchBtn"
                    onclick="clearSearchField()"
                    class="admin-search-clear"
                    style="display:none;">
                Clear
            </button>
        </div>
    </div>

<!-- ================= TOPIC CONTENT ==================== -->

@{
    var contentBlocks = Model.ContentBlocks
        .OrderBy(b => b.DisplayOrder)
        .ToList();
}

<div id="topicCardsWorkspaceGrid"
     class="admin-view-topics">

    @for (int i = 0; i < contentBlocks.Count; i++)
    {
        if (contentBlocks[i].Type != "heading")
        {
            continue;
        }

        var headingBlock = contentBlocks[i];
        var detailBlocks = new List<Aotearoa_is_Home.Models.ContentBlock>();

        for (int j = i + 1;
             j < contentBlocks.Count && contentBlocks[j].Type != "heading";
             j++)
        {
            detailBlocks.Add(contentBlocks[j]);
        }

        <!-- ================== TOPIC CARD ================= -->

        <div class="admin-view-topic search-target-topic-block">
            <div class="admin-view-topic-header">
                <div class="admin-topic-heading-icon">
                    📌
                </div>
                <h2 class="search-heading-text">
                    @headingBlock.Content
                </h2>
            </div>

            <div class="admin-view-topic-body">
                <div class="search-body-wrapper-text">
                    @foreach (var detail in detailBlocks)
                    {
                        @if (detail.Type == "subheading")
                        {
                            <h3 class="admin-view-subheading">
                                @detail.Content
                            </h3>
                        }

                        @if (detail.Type == "paragraph")
                        {
                            <p class="admin-view-paragraph">
                                @detail.Content
                            </p>
                        }

                        @if (detail.Type == "image")
                        {
                            <div class="admin-view-image-wrapper">

                                <img src="@detail.Content"
                                     class="admin-view-image"
                                     alt="Settlement information image"
                                     onerror="this.parentElement.innerHTML='<div class=&quot;admin-view-image-error&quot;>🔗 Image could not be displayed. <a href=&quot;' + this.src + '&quot; target=&quot;_blank&quot;>Open image link</a></div>'" />
                            </div>
                        }


                        @if (detail.Type == "link")
                        {
                            var linkDisplayText = "Visit Resource";
                            var linkTargetUrl = "#";

                            if (!string.IsNullOrWhiteSpace(detail.Content) &&
                                detail.Content.Contains("||"))
                            {
                                var pieces = detail.Content.Split("||", 2);

                                linkDisplayText = pieces[0];

                                linkTargetUrl =
                                    pieces.Length > 1
                                        ? pieces[1]
                                        : "#";
                            }
                            else
                            {
                                linkTargetUrl = detail.Content ?? "#";
                            }


                            <div class="admin-view-link-wrapper">

                                <a href="@linkTargetUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="admin-view-resource-link">
                                    🌐
                                    <span>
                                        @linkDisplayText
                                    </span>
                                    <span class="admin-view-link-arrow">
                                        ↗
                                    </span>
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>


<!-- ================= NO SEARCH RESULTS ============== -->

<div id="noSearchResultsAlert"
     class="admin-view-no-results"
     style="display: none !important;">

    <div class="admin-view-no-results-icon">
        🔍
    </div>
    <h3>
        No Topic Results Found
    </h3>

    <p>
        We couldn't find any content matching your search. Try another keyword.
    </p>
</div>
</div>

@section Scripts {
    <script>
        // Search string parser filter tracking input keywords
        function filterTopicsBySearch() {
            const query = document.getElementById("topicSearchBar").value.trim().toLowerCase();
            const topics = document.querySelectorAll(".search-target-topic-block");
            const clearBtn = document.getElementById("clearSearchBtn");
            let visibleCount = 0;

            clearBtn.style.display = query !== "" ? "inline-block" : "none";

            topics.forEach((topic) => {
                const headingText = topic.querySelector(".search-heading-text").innerText.toLowerCase();
                const bodyText = topic.querySelector(".search-body-wrapper-text").innerText.toLowerCase();

                // Unhide any card where the text string parameters intersect the header fields or details wrappers
                if (headingText.includes(query) || bodyText.includes(query)) {
                    topic.style.setProperty("display", "block", "important");
                    visibleCount++;
                } else {
                    topic.style.setProperty("display", "none", "important");
                }
            });

            // If visibility query drops to zero, invoke the desert empty banner placeholder block layout context
            const noResultsAlert = document.getElementById("noSearchResultsAlert");
            if (visibleCount === 0 && query !== "") {
                noResultsAlert.style.setProperty("display", "block", "important");
            } else {
                noResultsAlert.style.setProperty("display", "none", "important");
            }
        }

        function clearSearchField() {
            document.getElementById("topicSearchBar").value = "";
            filterTopicsBySearch();
            document.getElementById("topicSearchBar").focus();
        }
    </script>
    
    <style>
        /* Interactive animation transitions styles block context */
        .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important; }
        .hover-scale:hover { transform: scale(1.01); }
        .transition-all { transition: all 0.2s ease-in-out; }
        .bg-light-groove { background-color: #f9fbfd; }

        .admin-view-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 50px;
    align-items: center;
    padding: 35px 0 40px;
}

.admin-view-header-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.admin-view-header-content h1 {
    margin: 8px 0 15px;
}

.admin-view-header-content p {
    max-width: 620px;
    margin: 0;
    line-height: 1.7;
}

.admin-view-category-image {
    width: 100%;
    display: flex;
    justify-content: flex-end;
}

.admin-view-category-image-img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 18px;
    display: block;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
}

.admin-view-header-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    align-items: center;
}
    </style>
}
