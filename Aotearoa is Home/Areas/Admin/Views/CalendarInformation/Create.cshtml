@model Aotearoa_is_Home.Models.CalendarInformation

@{
    ViewData["Title"] = "Add Calendar Information";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Add Calendar Information</h2>

        <p class="text-muted">
            Add a public holiday, regional holiday or important reminder
            to the Aotearoa is Home calendar.
        </p>
    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="CalendarInformation"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                @* Title *@
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                        Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="e.g. Waitangi Day" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                @* Date *@
                <div class="mb-3">

                    <label asp-for="Date"
                           class="form-label">
                        Date
                    </label>

                    <input asp-for="Date"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Date"
                          class="text-danger">
                    </span>

                </div>


                @* Type *@
                <div class="mb-3">

                    <label asp-for="Type"
                           class="form-label">
                        Type
                    </label>

                    <select asp-for="Type"
                            class="form-select">

                        <option value="">
                            -- Select Type --
                        </option>

                        <option value="Public Holiday">
                            Public Holiday
                        </option>

                        <option value="Regional Holiday">
                            Regional Holiday
                        </option>

                        <option value="Reminder">
                            Reminder
                        </option>

                    </select>

                    <span asp-validation-for="Type"
                          class="text-danger">
                    </span>

                </div>


                @* Region *@
                <div class="mb-3">

                    <label asp-for="Region"
                           class="form-label">
                        Region
                    </label>

                    <input asp-for="Region"
                           class="form-control"
                           placeholder="e.g. Wellington or Nationwide" />

                </div>


                @* Description *@
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter useful information for students and families.">
                    </textarea>

                </div>


                @* Public Holiday *@
                <div class="form-check mb-3">

                    <input asp-for="IsPublicHoliday"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsPublicHoliday"
                           class="form-check-label">
                        Public Holiday
                    </label>

                </div>


                @* Shop Closure *@
                <div class="form-check mb-4">

                    <input asp-for="IsShopClosure"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsShopClosure"
                           class="form-check-label">
                        Shops or businesses may be closed
                    </label>

                </div>


                @* Buttons *@
                <div>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Calendar Information
                    </button>

                    <a asp-area="Admin"
                       asp-controller="CalendarInformation"
                       asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}