@model IEnumerable<Aotearoa_is_Home.Models.CalendarInformation>

@{
    ViewData["Title"] = "Calendar Information";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Calendar Information</h2>

            <p class="text-muted mb-0">
                Manage public holidays, regional holidays and important reminders.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="CalendarInformation"
           asp-action="Create"
           class="btn btn-primary">
            + Add Calendar Information
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No calendar information is currently available.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Region</th>
                        <th>Public Holiday</th>
                        <th>Shop Closure</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var information in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @information.Title
                                </strong>
                            </td>

                            <td>
                                @information.Date.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @information.Type
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(information.Region)
                                    ? "Nationwide"
                                    : information.Region)
                            </td>

                            <td>
                                @if (information.IsPublicHoliday)
                                {
                                    <span class="badge bg-success">
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No
                                    </span>
                                }
                            </td>

                            <td>
                                @if (information.IsShopClosure)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="CalendarInformation"
                                   asp-action="Edit"
                                   asp-route-id="@information.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="CalendarInformation"
                                   asp-action="Delete"
                                   asp-route-id="@information.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    }
</div>