@model IList<Aotearoa_is_Home.Models.ApplicationUser>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Verify Service Providers";

    var currentSearch = ViewBag.Search as string;
    var currentStatus = ViewBag.Status as string;
}

<div class="container my-5">

    <h1>Verify Service Providers</h1>

    <p class="text-muted">
        Review and approve service provider accounts.
    </p>

    <!-- Search and filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-area="Admin"
                  asp-controller="ServiceProvider"
                  asp-action="Index">

                <div class="row g-3 align-items-end">

                    <div class="col-md-7">
                        <label for="search" class="form-label">
                            Search
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@currentSearch"
                               class="form-control"
                               placeholder="Search by name, email or contact number..." />
                    </div>

                    <div class="col-md-3">
                        <label for="status" class="form-label">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value=""
                                    selected="@(string.IsNullOrEmpty(currentStatus))">
                                All
                            </option>

                            <option value="Pending"
                                    selected="@(currentStatus == "Pending")">
                                Pending
                            </option>

                            <option value="Approved"
                                    selected="@(currentStatus == "Approved")">
                                Approved
                            </option>

                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Search
                        </button>

                        <a href="@Url.Action("Index", "ServiceProvider", new { area = "Admin" })"
                            class="btn btn-outline-secondary">
                                Clear
                        </a>

                    </div>
                </div>
            </form>
        </div>
    </div>


    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">
                    No service provider accounts found.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Contact Number</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr style="cursor:pointer;"
                                    onclick="window.location='@Url.Action("Details", "ServiceProvider", new { area = "Admin", id = user.Id })'">

                                    <td>
                                        <strong>
                                            @user.FirstName @user.LastName
                                        </strong>
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(user.ContactNumber)
                                            ? "Not provided"
                                            : user.ContactNumber)
                                    </td>

                                    <td>
                                        @if (user.IsServiceProviderVerified)
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end"
                                        onclick="event.stopPropagation();">

                                        @if (!user.IsServiceProviderVerified)
                                        {
                                            <form action="@Url.Action("Approve", "ServiceProvider", new { area = "Admin" })"
                                                    method="post"
                                                    style="display:inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Approve
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small me-2">
                                                Verified
                                            </span>
                                        }

                                        @if (User.IsInRole("Super Admin"))
                                        {
                                            <form action="@Url.Action("Delete", "ServiceProvider", new { area = "Admin" })"
                                                    method="post"
                                                    style="display:inline"
                                                    onsubmit="return confirm('Are you sure you want to delete this service provider account?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>