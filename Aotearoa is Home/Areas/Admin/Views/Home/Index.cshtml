@model List<Aotearoa_is_Home.Models.SettlementPage>
@using System.Text.Encodings.Web

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Administrator Dashboard";
}

<div class="container my-5" style="max-width: 1000px;">
    <!-- Dashboard Hero Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom pb-4 mb-4 gap-3">
        <div>
            <h1 class="display-5 fw-extrabold text-dark mb-1">Admin Dashboard</h1>
            <p class="text-secondary mb-0">Manage structured forum settlement categories, cards, and resource directories.</p>
        </div>
        <div>
            <a href="/Admin/Settlement/Create" class="btn btn-primary btn-lg shadow-sm fw-bold d-flex align-items-center gap-2 px-4 py-2 hover-lift">
                <span>➕</span> Create New Category
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty Database State -->
        <div class="card text-center p-5 border-2 border-dashed bg-white shadow-xs rounded-3 my-4">
            <div class="display-4 mb-2">🏜️</div>
            <h4 class="fw-bold text-dark">No Settlement Hubs Exist</h4>
            <p class="text-muted mb-3">Get started by creating your very first public-facing categorical documentation dashboard.</p>
            <div>
                <a href="/Admin/Settlement/Create" class="btn btn-outline-primary btn-sm fw-bold">+ Add Hub Section</a>
            </div>
        </div>
    }
    else
    {
        <!-- Category Grid System -->
        <div class="row g-4">
            @foreach (var settlementPage in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100 border-top border-dark border-3 rounded-3 overflow-hidden d-flex flex-column bg-white">
                        <!-- Category Box Title Link Workspace Area Route -->
                        <a href="/Admin/Settlement/View/@settlementPage.Id" class="card-body p-4 text-decoration-none d-flex align-items-center justify-content-center text-center flex-grow-1 bg-hover-light transition-all">
                            <div>
                                <div class="fs-1 mb-2"></div>
                                <h2 class="h5 fw-bold text-dark mb-0 text-break px-2">@settlementPage.CategoryName</h2>
                            </div>
                        </a>

                        <div class="card-footer bg-light p-2 border-top d-flex justify-content-stretch gap-2">
                            <a href="/Admin/Settlement/Edit/@settlementPage.Id" class="btn btn-sm btn-outline-secondary w-50 fw-bold py-2">
                                ✏️ Edit
                            </a>
                            
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger w-50 fw-bold py-2" 
                                    onclick="confirmDelete('@settlementPage.Id', '@JavaScriptEncoder.Default.Encode(settlementPage.CategoryName)')">
                                🗑️ Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="deleteConfirmationModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="deleteModalLabel">
                    <span>⚠️</span> Permanent Deletion Warning
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="text-danger display-4 mb-3 animate-bounce-subtle">🗑️</div>
                <p class="fs-5 text-dark mb-1 font-semibold">Are you sure you want to delete this content?</p>
                <h4 class="fw-extrabold text-danger border border-danger border-dashed bg-light p-3 rounded my-3 text-break shadow-inner" id="deleteTargetCategoryName">Category Name</h4>
                <p class="text-muted small mb-0 leading-relaxed">This action cannot be undone. All nested topic cards, paragraph sections, links, and media files under this category layout will be erased from the database.</p>
            </div>
            <div class="modal-footer bg-light p-3 border-top">
                <div class="row w-100 g-2 m-0">
                    <div class="col-6 p-0 pe-1">
                        <button type="button" class="btn btn-secondary w-100 fw-bold py-2" data-bs-dismiss="modal">
                            Cancel, Keep Hub
                        </button>
                    </div>
                    <div class="col-6 p-0 ps-1">
                        <form id="deleteConfirmedForm" method="post" action="" class="w-100 m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100 fw-bold py-2">
                                Yes, Confirm Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Securely configures the unified deletion validation modal layout before sliding it onto screen
        function confirmDelete(id, name) {
            // 1. Inject the category text name explicitly into the verification panel block container
            document.getElementById("deleteTargetCategoryName").innerText = name;
            
            // 2. Point the target POST action property straight to your backend Settlement Controller pipeline route 
            document.getElementById("deleteConfirmedForm").action = `/Admin/Settlement/Delete/${id}`;
            
            // 3. Launch the bootstrap model context layer smoothly onto the user dashboard view
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmationModal'));
            deleteModal.show();
        }
    </script>

    <style>
        /* Modern interactive transition styles accents blocks definitions */
        .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.12) !important; }
        .bg-hover-light:hover { background-color: #fdfdfd !important; opacity: 0.93; }
        .transition-all { transition: all 0.2s ease-in-out; }
        .animate-bounce-subtle { animation: subtleBounce 2.5s infinite; }
        @@keyframes subtleBounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    </style>
}
