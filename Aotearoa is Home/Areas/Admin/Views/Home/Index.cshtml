
@model Aotearoa_is_Home.Models.ViewModels.AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Admin Dashboard
        </h2>

        <p class="text-muted mb-0">
            Overview of the Aotearoa is Home platform
        </p>

    </div>


    <!-- DASHBOARD STATISTICS -->
    <div class="row g-4 mb-4">

        <!-- TOTAL ACCOUNTS -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <p class="text-muted mb-2">
                        Total Accounts
                    </p>

                    <h2 class="fw-bold mb-1">
                        @Model.TotalAccounts
                    </h2>

                    <small class="text-muted">
                        Registered users
                    </small>

                </div>

            </div>

        </div>


        <!-- PENDING VERIFICATIONS -->
        <div class="col-md-6 col-xl-3"> 

            <div class="card border-0 shadow-sm h-100
                    @(Model.PendingVerifications > 0
                        ? "border-start border-warning border-4"
                        : "")">

                <div class="card-body">

                    <p class="text-muted mb-2">
                        Pending Verifications
                    </p>

                    <h2 class="fw-bold mb-1">
                        @Model.PendingVerifications
                    </h2>

                    <small class="text-muted">
                        Awaiting approval
                    </small>

                </div>

            </div>

        </div>


        <!-- SERVICE PROVIDERS -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100"> 

                <div class="card-body">

                    <p class="text-muted mb-2">
                        Service Providers
                    </p>

                    <h2 class="fw-bold mb-1">
                        @Model.ServiceProviders
                    </h2>

                    <small class="text-muted">
                        Registered providers
                    </small>

                </div>

            </div>

        </div>


        <!-- NEW THIS WEEK -->
        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <p class="text-muted mb-2">
                        New This Week
                    </p>

                    <h2 class="fw-bold mb-1">
                        @Model.NewThisWeek
                    </h2>

                    <small class="text-muted">
                        New accounts
                    </small>

                </div>

            </div>

        </div>


        @* PENDING COMMUNITY POSTS *@
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100
                        @(Model.PendingCommunityPosts > 0
                            ? "border-start border-warning border-4"
                            : "")">
                <div class="card-body">
                    <p class="text-muted mb-2">Pending Community Posts</p>
                    <h2 class="fw-bold mb-1">@Model.PendingCommunityPosts</h2>
                    <a asp-area="Admin"
                    asp-controller="Post"
                    asp-action="Index"
                    asp-route-status="Pending"
                    class="small text-decoration-none">
                        Review submissions →
                    </a>
                </div>
            </div>
        </div>

        @* PENDING EVENTS *@
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100
                        @(Model.PendingEvents > 0
                            ? "border-start border-warning border-4"
                            : "")">
                <div class="card-body">
                    <p class="text-muted mb-2">Pending Events</p>
                    <h2 class="fw-bold mb-1">@Model.PendingEvents</h2>
                    <a asp-area="Admin"
                    asp-controller="Event"
                    asp-action="Index"
                    asp-route-status="Pending Approval"
                    class="small text-decoration-none">
                        Review events →
                    </a>
                </div>
            </div>
        </div>

        @* PUBLISHED EVENTS *@
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Published Events</p>
                    <h2 class="fw-bold mb-1">@Model.PublishedEvents</h2>
                    <a asp-area="Admin"
                    asp-controller="Event"
                    asp-action="Index"
                    asp-route-status="Approved"
                    class="small text-decoration-none">
                        Manage events →
                    </a>
                </div>
            </div>
        </div>

        @* UPCOMING EVENT ATTENDEES *@
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Upcoming Event Attendees</p>
                    <h2 class="fw-bold mb-1">@Model.UpcomingEventAttendees</h2>
                    <small class="text-muted">
                        Registrations for upcoming events
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- QUICK ACTIONS -->
    <div class="card border-0 shadow-sm mb-4 quick-actions-section">
        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-4">
                <div class="quick-actions-heading-icon me-3">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">Quick Actions</h5>
                    <p class="text-muted small mb-0">
                        Access your most-used administration tasks
                    </p>
                </div>
            </div>

            <div class="row g-3">

                <!-- STUDENT REQUESTS -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <a asp-area="Admin"
                    asp-controller="StudentRegistration"
                    asp-action="Index"
                    class="quick-action-card quick-action-blue">

                        <div class="d-flex justify-content-between align-items-start">
                            <div class="quick-action-icon">
                                <i class="bi bi-person-check"></i>
                            </div>
                            <i class="bi bi-arrow-up-right quick-action-arrow"></i>
                        </div>

                        <h6 class="fw-bold mt-3 mb-2">
                            Student Requests
                        </h6>

                        <p class="text-muted small mb-3">
                            Review and process student registration requests.
                        </p>

                        <span class="quick-action-link">
                            Review requests <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </a>
                </div>

                <!-- VERIFY SERVICE PROVIDERS -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <a asp-area="Admin"
                    asp-controller="ServiceProvider"
                    asp-action="Index"
                    class="quick-action-card quick-action-green">

                        <div class="d-flex justify-content-between align-items-start">
                            <div class="quick-action-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <i class="bi bi-arrow-up-right quick-action-arrow"></i>
                        </div>

                        <h6 class="fw-bold mt-3 mb-2">
                            Verify Service Providers
                        </h6>

                        <p class="text-muted small mb-3">
                            Review provider details and verification status.
                        </p>

                        <span class="quick-action-link">
                            Verify providers <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </a>
                </div>

                <!-- MANAGE EVENTS -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <a asp-area="Admin"
                    asp-controller="Event"
                    asp-action="Index"
                    class="quick-action-card quick-action-amber">

                        <div class="d-flex justify-content-between align-items-start">
                            <div class="quick-action-icon">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <i class="bi bi-arrow-up-right quick-action-arrow"></i>
                        </div>

                        <h6 class="fw-bold mt-3 mb-2">
                            Manage Events
                        </h6>

                        <p class="text-muted small mb-3">
                            Review event submissions and manage published events.
                        </p>

                        <span class="quick-action-link">
                            Manage events <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </a>
                </div>

                <!-- COMMUNITY POSTS -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <a asp-area="Admin"
                    asp-controller="Post"
                    asp-action="Index"
                    class="quick-action-card quick-action-purple">

                        <div class="d-flex justify-content-between align-items-start">
                            <div class="quick-action-icon">
                                <i class="bi bi-chat-square-text"></i>
                            </div>
                            <i class="bi bi-arrow-up-right quick-action-arrow"></i>
                        </div>

                        <h6 class="fw-bold mt-3 mb-2">
                            Community Posts
                        </h6>

                        <p class="text-muted small mb-3">
                            Review and moderate community submissions.
                        </p>

                        <span class="quick-action-link">
                            Manage posts <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </a>
                </div>

            </div>
        </div>
    </div>


    <!-- RECENT USERS -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">
                Recent
            </h5>

            <p class="text-muted mb-0">
                Recently registered accounts
            </p>

        </div>


        <div class="card-body px-4">

            @if (Model.RecentUsers != null && Model.RecentUsers.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Registered</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>

                                    <!-- USER NAME -->
                                    <td class="fw-semibold">
                                        @user.FullName
                                    </td>

                                    <!-- EMAIL -->
                                    <td>
                                        @user.Email
                                    </td>

                                    <!-- ROLE -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(user.Role))
                                        {
                                            <span class="badge bg-light text-dark">
                                                @user.Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Role
                                            </span>
                                        }

                                    </td>

                                    <!-- REGISTERED DATE -->
                                    <td>

                                        @if (user.CreatedAt.HasValue)
                                        {
                                            @(user.CreatedAt.Value.ToLocalTime().ToString("dd MMM yyyy"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <p class="text-muted mb-0">
                        No recent accounts found.
                    </p>

                </div>
            }

        </div>

    </div>

</div>
