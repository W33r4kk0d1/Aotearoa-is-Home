@model Aotearoa_is_Home.Models.ViewModels.AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Admin Dashboard</h2>
        <p class="text-muted mb-0">
            Overview of the Aotearoa is Home platform
        </p>
    </div>


    <!-- Dashboard Statistics -->
    <div class="row g-4 mb-4">

        <!-- Total Accounts -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Accounts</p>

                    <h2 class="fw-bold mb-1">
                        @Model.TotalAccounts
                    </h2>

                    <small class="text-muted">
                        Registered users
                    </small>
                </div>
            </div>
        </div>


        <!-- Pending Verifications -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Pending Verifications</p>

                    <h2 class="fw-bold mb-1">
                        @Model.PendingVerifications
                    </h2>

                    <small class="text-muted">
                        Awaiting approval
                    </small>
                </div>
            </div>
        </div>


        <!-- Service Providers -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Service Providers</p>

                    <h2 class="fw-bold mb-1">
                        @Model.ServiceProviders
                    </h2>

                    <small class="text-muted">
                        Registered providers
                    </small>
                </div>
            </div>
        </div>


        <!-- New This Week -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">New This Week</p>

                    <h2 class="fw-bold mb-1">
                        @Model.NewThisWeek
                    </h2>

                    <small class="text-muted">
                        New accounts
                    </small>
                </div>
            </div>
        </div>

    </div>


    <!-- Recent Users -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-1">Recent</h5>

            <p class="text-muted mb-0">
                Recently registered accounts
            </p>
        </div>


        <div class="card-body px-4">

            @if (Model.RecentUsers != null && Model.RecentUsers.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Registered</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @user.FullName
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(user.Role))
                                        {
                                            <span class="badge bg-light text-dark">
                                                @user.Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Role
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.CreatedAt.HasValue)
                                        {
                                            @user.CreatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">
                        No recent accounts found.
                    </p>
                </div>
            }

        </div>

    </div>

</div>