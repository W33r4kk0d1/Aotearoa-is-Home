@model Aotearoa_is_Home.Models.ApplicationUser

@{
    ViewData["Title"] = "User Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="user-details-page">

    <div class="user-details-header">
        <div>
            <span class="page-eyebrow">USER MANAGEMENT</span>
            <h1>User Profile</h1>
            <p>View the registered user's account information.</p>
        </div>

        <div class="user-details-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn-edit-user">
                Edit User
            </a>

            <a href="/Users/Users/Index" class="btn-back-users">
                Back to Users
            </a>
        </div>
    </div>

    <div class="profile-card">

        <div class="profile-card-header">
            <div>
                <h2>@Model.FirstName @Model.LastName</h2>
                <p>@Model.Email</p>
            </div>

            <span class="profile-role-badge">
                @ViewBag.UserRoles
            </span>
        </div>

        <div class="profile-section">

            <h3>Personal Information</h3>

            <div class="profile-grid">

                <div class="profile-field">
                    <span class="profile-label">First Name</span>
                    <span class="profile-value">
                        @Model.FirstName
                    </span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Last Name</span>
                    <span class="profile-value">
                        @Model.LastName
                    </span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Email</span>
                    <span class="profile-value">
                        @Model.Email
                    </span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Contact Number</span>
                    <span class="profile-value">
                        @(string.IsNullOrWhiteSpace(Model.ContactNumber)
                            ? "Not provided"
                            : Model.ContactNumber)
                    </span>
                </div>

            </div>

        </div>

        <div class="profile-section">

            <h3>Account Information</h3>

            <div class="profile-grid">

                <div class="profile-field">
                    <span class="profile-label">Username</span>
                    <span class="profile-value">
                        @Model.UserName
                    </span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Role</span>
                    <span class="profile-value">
                        @ViewBag.UserRoles
                    </span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Language</span>
                    <span class="profile-value">
                        @(Model.Language?.Name ?? "Not provided")
                    </span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">LinkedIn Profile</span>
                    <span class="profile-value">
                        @if (!string.IsNullOrWhiteSpace(Model.LinkedInProfile))
                        {
                            <a href="@Model.LinkedInProfile"
                               target="_blank"
                               rel="noopener noreferrer">
                                View LinkedIn Profile
                            </a>
                        }
                        else
                        {
                            <span>Not provided</span>
                        }
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>