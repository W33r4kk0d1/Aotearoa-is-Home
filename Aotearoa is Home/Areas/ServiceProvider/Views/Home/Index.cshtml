@model Aotearoa_is_Home.Models.ViewModels.ServiceProviderDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Service Provider Dashboard";
}

<div class="sp-dashboard">

    <!-- Dashboard Header -->
    <div class="sp-dashboard-header">
        <span class="sp-label"> SERVICE PROVIDER </span>

        <h1> Welcome back, @Model.ProviderName 👋 </h1>

        <p> Here's an overview of your events and their activity.</p>
    </div>


    <!-- Statistics -->
    <section class="sp-section">

        <div class="sp-section-heading">
            <span class="sp-label"> OVERVIEW </span>

            <h2>Your event activity</h2>

            <p class="sp-section-description">
                Keep track of your events, approvals, and audience interest.
            </p>
        </div>


        <div class="sp-stats-grid">

            <!-- Total Events -->
            <div class="sp-stat-card">
                <span class="sp-stat-label"> TOTAL EVENTS </span>

                <strong class="sp-stat-number">
                    @Model.TotalEvents
                </strong>

                <span class="sp-stat-description">
                    Events you have created
                </span>
            </div>


            <!-- Upcoming Events -->
            <div class="sp-stat-card">
                <span class="sp-stat-label"> UPCOMING </span>

                <strong class="sp-stat-number"> @Model.UpcomingEvents </strong>

                <span class="sp-stat-description">  Events coming up </span>
            </div>


            <!-- Pending -->
            <div class="sp-stat-card">

                <span class="sp-stat-label"> PENDING </span>

                <strong class="sp-stat-number">
                    @Model.PendingApprovalEvents
                </strong>

                <span class="sp-stat-description"> Awaiting approval </span>
            </div>


            <!-- Approved -->
            <div class="sp-stat-card">

                <span class="sp-stat-label"> APPROVED </span>

                <strong class="sp-stat-number">
                    @Model.ApprovedEvents
                </strong>

                <span class="sp-stat-description"> Approved events </span>
            </div>


            <!-- People Interested -->
            <div class="sp-stat-card">
                <span class="sp-stat-label">
                    PEOPLE INTERESTED
                </span>

                <strong class="sp-stat-number">
                    @Model.PeopleInterested
                </strong>

                <span class="sp-stat-description">
                    Expressions of interest
                </span>
            </div>


            <!-- Event Views -->
            <div class="sp-stat-card">
                <span class="sp-stat-label"> EVENT VIEWS </span>

                <strong class="sp-stat-number">
                    @Model.EventViews
                </strong>

                <span class="sp-stat-description"> Total event views </span>
            </div>
        </div>
    </section>


    <!-- Upcoming Events -->
    <section class="sp-section">

        <div class="sp-section-heading">
            <span class="sp-label">
                UPCOMING EVENTS
            </span>

            <h2>Upcoming community events</h2>

            <p class="sp-section-description">
                Explore upcoming approved events from service providers.
            </p>
        </div>


        @if (Model.UpcomingEventList.Any())
        {
            <div class="sp-upcoming-events">
                @foreach (var eventItem in Model.UpcomingEventList)
                {
                    <article class="sp-upcoming-event-card">
                        <div class="sp-upcoming-event-content">

                            <span class="sp-action-label">
                                @eventItem.Category
                            </span>

                            <h3>@eventItem.Title</h3>

                            <p class="sp-event-meta">
                                @eventItem.StartDate.ToString("dddd, d MMMM yyyy")
                                ·
                                @eventItem.StartDate.ToString("h:mm tt")
                            </p>

                            <p class="sp-event-location">
                                @eventItem.Location
                            </p>

                            <span class="sp-event-status">
                                @eventItem.Status
                            </span>

                        </div>

                        <div class="sp-upcoming-event-actions">
                            <a href="@Url.Action(
                                "View",
                                "Event",
                                new
                                {
                                    area = "ServiceProvider",
                                    id = eventItem.Id
                                })"
                            class="sp-dashboard-button">
                                View
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="sp-empty-state">
                <h3>No upcoming events</h3>

                <p>
                    You don't have any upcoming events yet.
                    Create your first event to get started.
                </p>

                <a href="/ServiceProvider/Event/Create"
                   class="sp-dashboard-button">
                    Create Event
                </a>
            </div>
        }
    </section>


    <!-- Quick Actions -->
    <section class="sp-section">

        <div class="sp-section-heading">
            <span class="sp-label">
                QUICK ACTIONS
            </span>

            <h2>Manage your events</h2>

            <p class="sp-section-description">
                Quickly access the tools you use most.
            </p>
        </div>


        <div class="sp-action-grid">
            <!-- Create Event -->
            <a href="/ServiceProvider/Event/Create"
               class="sp-action-card sp-event-action-card">

                <div>
                    <span class="sp-action-label">
                        CREATE
                    </span>

                    <h3>
                        Create Event
                    </h3>

                    <p>
                        Create and submit a new community event
                        for approval.
                    </p>
                </div>

                <span class="sp-card-arrow"
                      aria-hidden="true">
                    →
                </span>
            </a>


            <!-- Manage Events -->
            <a href="/ServiceProvider/Event/Index"
               class="sp-action-card sp-event-action-card">

                <div>
                    <span class="sp-action-label">
                        MANAGE
                    </span>

                    <h3>
                        Manage Events
                    </h3>

                    <p>
                        View, edit, and delete your submitted
                        events.
                    </p>
                </div>

                <span class="sp-card-arrow"
                      aria-hidden="true">
                    →
                </span>
            </a>
        </div>
    </section>
</div>