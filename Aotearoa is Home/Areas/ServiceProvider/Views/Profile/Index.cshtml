@model Aotearoa_is_Home.Models.EventProviderProfile

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>My Profile</h1>

            <p class="text-muted mb-0">
                View your organisation and service provider information.
            </p>
        </div>

    </div>

    <div class="card shadow-sm mb-5">

        <div class="card-header">
            <h4 class="mb-0">Organisation Information</h4>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Organisation Name</strong>
                </div>
                <div class="col-md-8">
                    @Model.OrganisationName
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Organisation Type</strong>
                </div>
                <div class="col-md-8">
                    @Model.OrganisationType
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Description</strong>
                </div>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.OrganisationDescription)
                        ? "Not provided"
                        : Model.OrganisationDescription)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Email</strong>
                </div>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.User?.Email)
                        ? "Not provided"
                        : Model.User.Email)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Phone</strong>
                </div>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.OrganisationPhone)
                        ? "Not provided"
                        : Model.OrganisationPhone)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Website</strong>
                </div>
                <div class="col-md-8">
                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                    {
                        <a href="@Model.Website"
                           target="_blank"
                           rel="noopener noreferrer">
                            @Model.Website
                        </a>
                    }
                    else
                    {
                        <span>Not provided</span>
                    }
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Office Address</strong>
                </div>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.OfficeAddress)
                        ? "Not provided"
                        : Model.OfficeAddress)
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <strong>Supporting Information</strong>
                </div>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.SupportingInformation)
                        ? "Not provided"
                        : Model.SupportingInformation)
                </div>
            </div>

        </div>

    </div>

</div>
