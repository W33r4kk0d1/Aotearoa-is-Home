@model Aotearoa_is_Home.Models.Event

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Event";
}

<div class="container admin-container">

    <h1>Create Event</h1>

    <p class="admin-subtitle">
        Create an event for users to discover.
    </p>

    <form action="/ServiceProvider/Event/Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()


        <!-- EVENT TITLE -->

        <div class="mb-3">

            <label for="Title" class="form-label">
                Event Title
            </label>

            <input type="text"
                   id="Title"
                   name="Title"
                   class="form-control"
                   placeholder="Enter event title"
                   required />

        </div>


        <!-- DESCRIPTION -->

        <div class="mb-3">

            <label for="Description" class="form-label">
                Description
            </label>

            <textarea id="Description"
                      name="Description"
                      class="form-control"
                      rows="6"
                      placeholder="Describe the event"
                      required></textarea>

        </div>


        <!-- LOCATION / VENUE -->

        <div class="mb-3">

            <label for="Location" class="form-label">
                Location / Venue
            </label>

            <input type="text"
                   id="Location"
                   name="Location"
                   class="form-control"
                   placeholder="e.g. WelTec Petone Campus"
                   maxlength="150"
                   required />

        </div>


        <!-- REGION -->

        <div class="mb-3">

            <label for="Region" class="form-label">
                Region
            </label>

            <select id="Region"
                    name="Region"
                    class="form-select"
                    required>

                <option value="">
                    Select a region
                </option>

                <option value="Wellington">
                    Wellington
                </option>

                <option value="Lower Hutt">
                    Lower Hutt
                </option>

                <option value="Upper Hutt">
                    Upper Hutt
                </option>

                <option value="Porirua">
                    Porirua
                </option>

                <option value="Kapiti Coast">
                    Kapiti Coast
                </option>

                <option value="Other">
                    Other
                </option>

            </select>

        </div>


        <!-- DATE AND TIME -->

        <div class="row">

            <div class="col-md-6 mb-3">

                <label for="StartDate" class="form-label">
                    Start Date & Time
                </label>

                <input type="datetime-local"
                       id="StartDate"
                       name="StartDate"
                       class="form-control"
                       required />

            </div>


            <div class="col-md-6 mb-3">

                <label for="EndDate" class="form-label">
                    End Date & Time
                </label>

                <input type="datetime-local"
                       id="EndDate"
                       name="EndDate"
                       class="form-control"
                       required />

            </div>

        </div>


        <!-- CATEGORY -->

        <div class="mb-3">

            <label for="Category" class="form-label">
                Event Category
            </label>

            <select id="Category"
                    name="Category"
                    class="form-select"
                    required>

                <option value="">
                    Select a category
                </option>

                <option value="Community">
                    Community
                </option>

                <option value="Education">
                    Education
                </option>

                <option value="Employment">
                    Employment
                </option>

                <option value="Culture">
                    Culture
                </option>

                <option value="Sports">
                    Sports
                </option>

                <option value="Family">
                    Family
                </option>

                <option value="Other">
                    Other
                </option>

            </select>

        </div>


        <!-- EVENT IMAGE -->

        <div class="mb-4">

            <label for="eventImage" class="form-label">
                Event Image
            </label>

            <input type="file"
                   id="eventImage"
                   name="eventImage"
                   class="form-control"
                   accept="image/*" />

        </div>


        <!-- BUTTONS -->

        <div>

            <button type="submit"
                    class="admin-create-button">

                Create Event

            </button>

            <a href="/ServiceProvider/Event/Index"
               class="admin-edit-button">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}