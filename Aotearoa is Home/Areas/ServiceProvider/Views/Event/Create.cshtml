@model Aotearoa_is_Home.Models.Event

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Event";
}

<div class="event-create-page">

    @* ## Back Navigation *@
    <div class="event-back-link">
        <a href="/ServiceProvider/Event/Index">
            ← Back to events
        </a>
    </div>


    @* ## Page Header *@
    <div class="event-create-header">

        <span class="event-page-label">
            NEW EVENT
        </span>

        <h1>Create Event</h1>

        <p>
            Create an event for users to discover and submit it for review.
        </p>

    </div>


    @* ## Create Event Form *@
    <form action="/ServiceProvider/Event/Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()


        <div class="event-form-card">


            @* ## Event Image *@
            <div class="event-form-group">

                <label for="eventImage"
                       class="event-field-label">
                    EVENT IMAGE
                </label>


                <label for="eventImage"
                       class="event-image-upload">

                    <div class="event-upload-icon">
                        ↑
                    </div>

                    <strong>
                        Upload event image
                    </strong>

                    <span>
                        Click to choose an image
                    </span>

                    <span class="event-upload-file"
                          id="selectedFileName">
                        No file selected
                    </span>

                </label>


                <input type="file"
                       id="eventImage"
                       name="eventImage"
                       class="event-file-input"
                       accept="image/*" />

            </div>


            @* ## Event Title *@
            <div class="event-form-group">

                <label for="Title"
                       class="event-field-label">
                    EVENT TITLE
                </label>

                <input type="text"
                       id="Title"
                       name="Title"
                       class="event-input"
                       placeholder="Enter event title"
                       required />

            </div>


            @* ## Description *@
            <div class="event-form-group">

                <label for="Description"
                       class="event-field-label">
                    DESCRIPTION
                </label>

                <textarea id="Description"
                          name="Description"
                          class="event-textarea"
                          rows="6"
                          placeholder="Describe the event"
                          required></textarea>

            </div>


            @* ## Location and Region *@
            <div class="event-form-row">

                @* ## Location *@
                <div class="event-form-group">

                    <label for="Location"
                           class="event-field-label">
                        LOCATION / VENUE
                    </label>

                    <input type="text"
                           id="Location"
                           name="Location"
                           class="event-input"
                           placeholder="e.g. WelTec Petone Campus"
                           maxlength="150"
                           required />

                </div>


                @* ## Region *@
                <div class="event-form-group">

                    <label for="Region"
                           class="event-field-label">
                        REGION
                    </label>

                    <select id="Region"
                            name="Region"
                            class="event-input event-select"
                            required>

                        <option value="">
                            Select a region
                        </option>

                        <option value="Wellington">
                            Wellington
                        </option>

                        <option value="Lower Hutt">
                            Lower Hutt
                        </option>

                        <option value="Upper Hutt">
                            Upper Hutt
                        </option>

                        <option value="Porirua">
                            Porirua
                        </option>

                        <option value="Kapiti Coast">
                            Kapiti Coast
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>

            </div>


            @* ## Start and End Date *@
            <div class="event-form-row">

                @* ## Start Date *@
                <div class="event-form-group">

                    <label for="StartDate"
                           class="event-field-label">
                        START DATE &amp; TIME
                    </label>

                    <input type="datetime-local"
                           id="StartDate"
                           name="StartDate"
                           class="event-input"
                           required />

                </div>


                @* ## End Date *@
                <div class="event-form-group">

                    <label for="EndDate"
                           class="event-field-label">
                        END DATE &amp; TIME
                    </label>

                    <input type="datetime-local"
                           id="EndDate"
                           name="EndDate"
                           class="event-input"
                           required />

                </div>

            </div>


            @* ## Event Category *@
            <div class="event-form-group">

                <label for="Category"
                       class="event-field-label">
                    EVENT CATEGORY
                </label>

                <select id="Category"
                        name="Category"
                        class="event-input event-select"
                        required>

                    <option value="">
                        Select a category
                    </option>

                    <option value="Community">
                        Community
                    </option>

                    <option value="Education">
                        Education
                    </option>

                    <option value="Employment">
                        Employment
                    </option>

                    <option value="Culture">
                        Culture
                    </option>

                    <option value="Sports">
                        Sports
                    </option>

                    <option value="Family">
                        Family
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>

            </div>


            @* ## Form Buttons *@
            <div class="event-form-actions">

                <a href="/ServiceProvider/Event/Index"
                   class="event-cancel-button">

                    Cancel

                </a>


                <button type="submit"
                        class="event-submit-button">

                    Create Event →

                </button>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        // ## Display selected image filename

        const eventImage =
            document.getElementById("eventImage");

        const selectedFileName =
            document.getElementById("selectedFileName");


        eventImage.addEventListener("change", function () {

            if (this.files.length > 0) {

                selectedFileName.textContent =
                    this.files[0].name;

            }
            else {

                selectedFileName.textContent =
                    "No file selected";

            }

        });

    </script>

}