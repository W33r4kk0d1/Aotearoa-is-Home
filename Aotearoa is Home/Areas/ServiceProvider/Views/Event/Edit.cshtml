@model Aotearoa_is_Home.Models.Event

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Event";

    // Current browser/server minimum date.
    var minimumDateTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="event-create-page">

    <!-- Back Navigation -->
    <div class="event-back-link">
        <a href="/ServiceProvider/Event/Index">
            ← Back to events
        </a>
    </div>

    <!-- Page Header -->
    <div class="event-create-header">

        <span class="event-page-label">
            EDIT EVENT
        </span>

        <h1>Edit Event</h1>

        <p>
            Update your event information and save your changes.
        </p>

    </div>

    <!-- Validation Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="event-validation-summary"
             asp-validation-summary="All">
        </div>
    }

    <!-- Edit Event Form -->
    <form asp-area="ServiceProvider"
          asp-controller="Event"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <!-- Event ID -->
        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <div class="event-form-card">

            <!-- EVENT IMAGE -->
            <div class="event-form-group">

                <label for="eventImage"
                       class="event-field-label">
                    EVENT IMAGE
                </label>

                <label for="eventImage"
                       class="event-image-upload">

                    <div class="event-upload-icon">
                        ↑
                    </div>

                    <strong> Change event image</strong>

                    <span>Click to choose a new image</span>

                    <span class="event-upload-file"
                          id="selectedFileName">
                        Keep current image
                    </span>
                </label>

                <input type="file"
                       id="eventImage"
                       name="eventImage"
                       class="event-file-input"
                       accept="image/*" />
            </div>


            <!-- EVENT TITLE -->
            <div class="event-form-group">

                <label for="Title"
                       class="event-field-label">
                    EVENT TITLE
                </label>

                <input type="text"
                       id="Title"
                       name="Title"
                       class="event-input"
                       value="@Model.Title"
                       placeholder="Enter event title"
                       maxlength="200"
                       required />

                <span asp-validation-for="Title" class="text-danger"></span>
            </div>


            <!-- DESCRIPTION -->
            <div class="event-form-group">

                <label for="Description"
                       class="event-field-label">
                    DESCRIPTION
                </label>

                <textarea id="Description"
                          name="Description"
                          class="event-textarea"
                          rows="6"
                          placeholder="Describe the event"
                          required>@Model.Description</textarea>

                <span asp-validation-for="Description"  class="text-danger"></span>

            </div>


            <!-- LOCATION + REGION -->
            <div class="event-form-row">

                <!-- LOCATION -->
                <div class="event-form-group">

                    <label for="Location"
                           class="event-field-label">
                        LOCATION / VENUE
                    </label>

                    <input type="text"
                           id="Location"
                           name="Location"
                           class="event-input"
                           value="@Model.Location"
                           placeholder="e.g. WelTec Petone Campus"
                           maxlength="150"
                           required />

                    <span asp-validation-for="Location"  class="text-danger"></span>

                </div>


                <!-- REGION -->
                <div class="event-form-group">

                    <label for="Region"
                           class="event-field-label">
                        REGION
                    </label>

                    <select id="Region"
                            name="Region"
                            class="event-input event-select"
                            required>

                        <option value="">
                            Select a region
                        </option>

                        <option value="Wellington"
                                selected="@(Model.Region == "Wellington")">
                            Wellington
                        </option>

                        <option value="Lower Hutt"
                                selected="@(Model.Region == "Lower Hutt")">
                            Lower Hutt
                        </option>

                        <option value="Upper Hutt"
                                selected="@(Model.Region == "Upper Hutt")">
                            Upper Hutt
                        </option>

                        <option value="Porirua"
                                selected="@(Model.Region == "Porirua")">
                            Porirua
                        </option>

                        <option value="Kapiti Coast"
                                selected="@(Model.Region == "Kapiti Coast")">
                            Kapiti Coast
                        </option>

                        <option value="Other"
                                selected="@(Model.Region == "Other")">
                            Other
                        </option>

                    </select>

                    <span asp-validation-for="Region" class="text-danger"> </span>
                </div>
            </div>


            <!-- START + END DATE -->
            <div class="event-form-row">

                <!-- START -->
                <div class="event-form-group">

                    <label for="StartDate"
                           class="event-field-label">
                        START DATE &amp; TIME
                    </label>

                    <input type="datetime-local"
                           id="StartDate"
                           name="StartDate"
                           class="event-input"
                           min="@minimumDateTime"
                           value="@(Model.StartDate > DateTime.MinValue
                               ? Model.StartDate.ToString("yyyy-MM-ddTHH:mm")
                               : "")"
                           required />

                    <span asp-validation-for="StartDate"  class="text-danger"></span>
                </div>

                <!-- END -->
                <div class="event-form-group">

                    <label for="EndDate"
                           class="event-field-label">
                        END DATE &amp; TIME
                    </label>

                    <input type="datetime-local"
                           id="EndDate"
                           name="EndDate"
                           class="event-input"
                           min="@minimumDateTime"
                           value="@(Model.EndDate > DateTime.MinValue
                               ? Model.EndDate.ToString("yyyy-MM-ddTHH:mm")
                               : "")"
                           required />

                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>


            <!-- CATEGORY -->
            <div class="event-form-group">

                <label for="Category"
                       class="event-field-label">
                    EVENT CATEGORY
                </label>

                <select id="Category"
                        name="Category"
                        class="event-input event-select"
                        required>

                    <option value="">Select a category</option>

                    <option value="Community"
                            selected="@(Model.Category == "Community")">
                        Community
                    </option>

                    <option value="Education"
                            selected="@(Model.Category == "Education")">
                        Education
                    </option>

                    <option value="Employment"
                            selected="@(Model.Category == "Employment")">
                        Employment
                    </option>

                    <option value="Culture"
                            selected="@(Model.Category == "Culture")">
                        Culture
                    </option>

                    <option value="Sports"
                            selected="@(Model.Category == "Sports")">
                        Sports
                    </option>

                    <option value="Family"
                            selected="@(Model.Category == "Family")">
                        Family
                    </option>

                    <option value="Other"
                            selected="@(Model.Category == "Other")">
                        Other
                    </option>
                </select>

                <span asp-validation-for="Category"  class="text-danger"> </span>
            </div>


            <!-- OFFICIAL EVENT INFORMATION -->
            <div class="event-feature-section">

                <div class="event-feature-header">

                    <span class="event-field-label">
                        OFFICIAL EVENT INFORMATION
                    </span>

                </div>

                <div class="event-form-group">

                    <label for="OfficialEventLink"
                           class="event-field-label">
                        OFFICIAL EVENT LINK
                    </label>

                    <input type="url"
                           id="OfficialEventLink"
                           name="OfficialEventLink"
                           class="event-input"
                           value="@Model.OfficialEventLink"
                           placeholder="https://example.com/event"
                           maxlength="500" />

                    <small class="event-help-text">
                        Optional. Add the official website, Facebook event,
                        Eventbrite page, or other official event information.
                    </small>

                    <span asp-validation-for="OfficialEventLink" class="text-danger"> </span>
                </div>
            </div>


            <!-- EVENT RESPONSE -->
            <div class="event-feature-section">
                <div class="event-response-header">
                    <div>
                        <span class="event-field-label">
                            EVENT RESPONSE
                        </span>

                        <p class="event-response-description">
                            Allow visitors to express interest in this event.
                        </p>
                    </div>


                    <!-- Toggle -->
                    <label class="event-toggle">

                        <input type="checkbox"
                               id="EnableResponses"
                               name="EnableResponses"
                               value="true"
                               @(Model.EnableResponses ? "checked" : "") />

                        <span class="event-toggle-slider"></span>
                    </label>
                </div>


                <!-- Response Options -->
                <div id="responseOptions"
                     class="event-response-options"
                     style="display: none;">

                    <!-- Record responses -->
                    <label class="event-checkbox-option">

                        <input type="checkbox"
                               id="RecordResponses"
                               name="RecordResponses"
                               value="true"
                               @(Model.RecordResponses ? "checked" : "") />

                        <span>
                            <strong> Record expressions of interest</strong>

                            <small> Keep track of how many people are interested.</small>
                        </span>
                    </label>


                    <!-- Show count -->
                    <label class="event-checkbox-option">

                        <input type="checkbox"
                               id="ShowResponseCount"
                               name="ShowResponseCount"
                               value="true"
                               @(Model.ShowResponseCount ? "checked" : "") />

                        <span>
                            <strong> Show interest count publicly </strong>

                            <small> Visitors can see how many people are interested.</small>
                        </span>
                    </label>


                    <!-- Email -->
                    <label class="event-checkbox-option">

                        <input type="checkbox"
                               id="EmailOnResponse"
                               name="EmailOnResponse"
                               value="true"
                               @(Model.EmailOnResponse ? "checked" : "") />

                        <span>
                            <strong> Email me when someone expresses interest</strong>

                            <small> Receive an email notification when someone responds.</small>
                        </span>
                    </label>
                </div>
            </div>


            <!-- FORM ACTIONS -->
            <div class="event-form-actions">

                <a href="/ServiceProvider/Event/Index"
                   class="event-cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        class="event-submit-button">
                    Save Changes →
                </button>

            </div>
        </div>
    </form>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // IMAGE FILE NAME

        const eventImage =
            document.getElementById("eventImage");

        const selectedFileName =
            document.getElementById("selectedFileName");

        eventImage.addEventListener("change", function () {

            if (this.files.length > 0) {
                selectedFileName.textContent = this.files[0].name;
            }
            else {
                selectedFileName.textContent = "Keep current image";
            }
        });


        // EVENT RESPONSE TOGGLE
        const responseToggle =
            document.getElementById("EnableResponses");

        const responseOptions =
            document.getElementById("responseOptions");

        const recordResponses =
            document.getElementById("RecordResponses");

        const showResponseCount =
            document.getElementById("ShowResponseCount");

        const emailOnResponse =
            document.getElementById("EmailOnResponse");


        function updateResponseOptions() {

            if (responseToggle.checked) {
                responseOptions.style.display = "block";
            }
            else {
                responseOptions.style.display = "none";
                recordResponses.checked = false;
                showResponseCount.checked = false;
                emailOnResponse.checked = false;
            }
        }


        responseToggle.addEventListener(
            "change",
            updateResponseOptions
        );

        updateResponseOptions();

        // FUTURE DATE VALIDATION
        const startDate =
            document.getElementById("StartDate");

        const endDate =
            document.getElementById("EndDate");

        function getCurrentLocalDateTime() {

            const now = new Date();

            const year = now.getFullYear();

            const month =
                String(now.getMonth() + 1)
                    .padStart(2, "0");

            const day =
                String(now.getDate())
                    .padStart(2, "0");

            const hours =
                String(now.getHours())
                    .padStart(2, "0");

            const minutes =
                String(now.getMinutes())
                    .padStart(2, "0");

            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        function updateDateMinimums() {

            const now = getCurrentLocalDateTime();

            startDate.min = now;
            endDate.min = now;

            if (startDate.value) {
                endDate.min = startDate.value;
            }
        }

        updateDateMinimums();


        // Keep the minimum start date current.
        setInterval(
            updateDateMinimums,
            60000
        );


        startDate.addEventListener(
            "change",
            function () {
                endDate.min =
                    startDate.value;

                if (
                    endDate.value &&
                    endDate.value <= startDate.value
                ) {
                    endDate.value = "";
                }
            }
        );


        // FORM VALIDATION
        document.querySelector("form")
            .addEventListener("submit", function (event) {

                const now = new Date();

                const selectedStart =
                    new Date(startDate.value);

                const selectedEnd =
                    new Date(endDate.value);


                // Start must be in the future.
                if (
                    !startDate.value ||
                    selectedStart <= now
                ) {

                    event.preventDefault();

                    alert( "Event start date and time must be in the future.");

                    startDate.focus();

                    return;
                }


                // End must be after start.
                if (
                    !endDate.value ||
                    selectedEnd <= selectedStart
                ) {

                    event.preventDefault();

                    alert( "Event end date and time must be after the start date and time.");

                    endDate.focus();

                    return;

                }
            });
    </script>
}