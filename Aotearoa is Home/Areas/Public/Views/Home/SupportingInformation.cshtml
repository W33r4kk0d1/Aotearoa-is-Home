@{
    ViewData["Title"] = "Supporting Information";
    ViewData["HideHeader"] = true;
}

<div class="supporting-information-page">

    <div class="supporting-information-container">

        <div class="settle-logo">
                <img src="~/images/Logo.png"
                    alt="Aotearoa is Home"
                    asp-append-version="true" />
            </div>

        <h1>Supporting Information</h1>

        <p class="supporting-intro">
            <b>Aotearoa is Home</b> provides general information to help
            international students and their families settle,
            study, work and connect in New Zealand.
        </p>

        <section class="supporting-card">

            <h2>What this website provides</h2>

            <p>
                This website brings together general information and
                useful resources that may help international students
                and families understand everyday life and access
                relevant services and support in New Zealand.
            </p>

        </section>

        <section class="supporting-card">

            <h2>Important information</h2>

            <p>
                Aotearoa is Home provides information for general
                educational and informational purposes only.
            </p>

            <p>
                We are not a government agency, legal service,
                immigration adviser, financial adviser, medical
                service or professional counselling service.
            </p>

            <p>
                The website does not provide legal, immigration,
                financial, medical or other professional advice.
            </p>

        </section>

        <section class="supporting-card">

            <h2>Using the information</h2>

            <p>
                The information available through Aotearoa is Home
                should be used as a starting point for finding
                relevant services and resources.
            </p>

            <p>
                Where professional or official advice is required,
                users should contact the appropriate qualified
                professional, organisation or New Zealand government
                agency.
            </p>

            <p>
                Users should verify important information with the relevant
                official organisation or service provider, as requirements and
                services may change over time.
            </p>
        </section>

        <section class="supporting-card">

            <h2>Our goal</h2>

            <p>
                Our goal is to make useful settlement information
                easier to discover and help international students
                and their families feel more confident as they build
                their lives and connections in Aotearoa New Zealand.
            </p>

        </section>

        <div class="supporting-back">

            <a asp-controller="Home"
               asp-action="Index"
               class="public-btn public-btn-primary">
                ← Back to Home
            </a>

        </div>

    </div>

</div>