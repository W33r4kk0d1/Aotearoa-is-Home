@model Aotearoa_is_Home.Models.ApplicationUser

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Profile</h1>
            <p class="text-muted mb-0">
                View and manage your personal information.
            </p>
        </div>

        <a href="@Url.Action("Edit", "Profile", new { area = "Family" })"
        class="btn btn-primary">
            Edit Profile
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Personal Information</h4>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4"><strong>First Name</strong></div>
                <div class="col-md-8">
                    @(Model.FirstName ?? "Not provided")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4"><strong>Last Name</strong></div>
                <div class="col-md-8">
                    @(Model.LastName ?? "Not provided")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4"><strong>Email</strong></div>
                <div class="col-md-8">
                    @(Model.Email ?? "Not provided")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4"><strong>Contact Number</strong></div>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.ContactNumber)
                        ? "Not provided"
                        : Model.ContactNumber)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4"><strong>Language</strong></div>
                <div class="col-md-8">
                    @(Model.LanguageId.HasValue
                        ? Model.LanguageId.ToString()
                        : "Not provided")
                </div>
            </div>

            <div class="row">
                <div class="col-md-4"><strong>LinkedIn Profile</strong></div>
                <div class="col-md-8">
                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInProfile))
                    {
                        <a href="@Model.LinkedInProfile"
                           target="_blank"
                           rel="noopener noreferrer">
                            @Model.LinkedInProfile
                        </a>
                    }
                    else
                    {
                        <span>Not provided</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>