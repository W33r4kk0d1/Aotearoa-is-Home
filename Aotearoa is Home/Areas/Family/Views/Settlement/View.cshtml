@model Aotearoa_is_Home.Models.SettlementPage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CategoryName;

    // Get the current area (Student or Family)
    var currentArea =
        ViewContext.RouteData.Values["area"]?.ToString();

    var nzTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Pacific/Auckland");

    var lastUpdated =
        TimeZoneInfo.ConvertTimeFromUtc(
            Model.UpdatedAt,
            nzTimeZone);

    var imageName = Model.CategoryName
        .ToLower()
        .Replace(" ", "-") + ".jpg";
}

<div class="student-settlement-view">

    <div class="student-settlement-back">
        <a href="@Url.Action(
                    "Index",
                    "Settlement",
                    new { area = currentArea })"
           class="student-back-button">

            ← Back to Settlement Information

        </a>
    </div>

    <section class="student-settlement-hero">

        <img src="@Url.Content($"~/images/settlement/{imageName}")"
             alt="@Model.CategoryName"
             class="student-settlement-hero-image" />

        <div class="student-settlement-hero-overlay"></div>

        <div class="student-settlement-hero-content">

            <span class="student-eyebrow">
                SETTLEMENT INFORMATION
            </span>

            <h1>
                @Model.CategoryName
            </h1>

            <p>
                Helpful information and resources to help you
                settle into Aotearoa New Zealand.
            </p>

        </div>

    </section>

    <div class="student-settlement-meta">

        <span>
            Last updated:
        </span>

        <strong>
            @lastUpdated.ToString("dd MMMM yyyy, h:mm tt")
        </strong>

    </div>

    <div class="student-content-search">

        <div class="student-search-wrapper">

            <span class="student-search-icon">
                🔍
            </span>

            <input type="text"
                   id="contentSearch"
                   class="student-search-input"
                   placeholder="Search this page..."
                   autocomplete="off" />

        </div>

    </div>

    <div id="contentNoResults"
         class="student-content-no-results"
         style="display: none;">

        No matching information found.

    </div>

    <section class="student-settlement-content"
             id="settlementContent">

        @foreach (var block in Model.ContentBlocks
            .OrderBy(b => b.DisplayOrder))
        {

            @if (block.Type == "heading")
            {
                <h2 class="student-content-heading searchable-content">
                    @block.Content
                </h2>
            }

            else if (block.Type == "subheading")
            {
                <h3 class="student-content-subheading searchable-content">
                    @block.Content
                </h3>
            }

            else if (block.Type == "paragraph")
            {
                <p class="student-content-paragraph searchable-content">
                    @block.Content
                </p>
            }

            else if (block.Type == "image")
            {
                <div class="student-content-image searchable-content">

                    @if (block.ImageData != null &&
                         block.ImageData.Length > 0)
                    {
                        <img src="data:@block.ImageContentType;base64,@Convert.ToBase64String(block.ImageData)"
                             alt="@Model.CategoryName" />
                    }
                    else if (!string.IsNullOrWhiteSpace(block.Content))
                    {
                        <img src="@block.Content"
                             alt="@Model.CategoryName" />
                    }

                </div>
            }

            else if (block.Type == "link")
            {
                var linkDisplayText = "Visit Resource";
                var linkTargetUrl = "#";

                if (!string.IsNullOrWhiteSpace(block.Content) &&
                    block.Content.Contains("||"))
                {
                    var pieces = block.Content.Split("||", 2);

                    linkDisplayText = pieces[0].Trim();

                    linkTargetUrl =
                        pieces.Length > 1
                            ? pieces[1].Trim()
                            : "#";
                }
                else
                {
                    linkTargetUrl =
                        block.Content?.Trim() ?? "#";
                }

                <div class="student-content-link searchable-content">

                    <a href="@linkTargetUrl"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span class="student-content-link-icon">
                            🔗
                        </span>

                        <span class="student-content-link-text">
                            @linkDisplayText
                        </span>

                        <span class="student-content-link-arrow">
                            ↗
                        </span>

                    </a>

                </div>
            }

        }

    </section>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("contentSearch");

        const contentBlocks =
            document.querySelectorAll(".searchable-content");

        const noResults =
            document.getElementById("contentNoResults");


        searchInput.addEventListener("input", function () {

            const searchText =
                this.value.trim().toLowerCase();

            let visibleCount = 0;


            contentBlocks.forEach(function (block) {

                const text =
                    block.textContent.toLowerCase();

                if (text.includes(searchText)) {

                    block.style.display = "";

                    visibleCount++;

                } else {

                    block.style.display = "none";

                }

            });


            if (visibleCount === 0 && searchText !== "") {

                noResults.style.display = "block";

            } else {

                noResults.style.display = "none";

            }

        });

    });

</script>